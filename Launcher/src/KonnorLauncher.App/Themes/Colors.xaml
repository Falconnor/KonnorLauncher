<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:th="clr-namespace:KonnorLauncher.App.Theming">

    <SolidColorBrush x:Key="White" Color="#FFFFFFFF" />

    <!-- Fondo alternativo si background.png no carga -->
    <LinearGradientBrush x:Key="FallbackBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{Binding [FallbackTop], Source={x:Static th:ThemePalette.Current}}" Offset="0" />
        <GradientStop Color="{Binding [FallbackBottom], Source={x:Static th:ThemePalette.Current}}" Offset="1" />
    </LinearGradientBrush>

    <!-- Sombra de paneles (BlurRadius 30, negro α150) -->
    <DropShadowEffect x:Key="PanelShadow" BlurRadius="30" ShadowDepth="0" Color="Black" Opacity="0.59" />
</ResourceDictionary>
