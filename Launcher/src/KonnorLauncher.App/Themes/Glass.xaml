<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:KonnorLauncher.App.Controls"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ═══════════════════════════════════════════════════════════════════
         Glassmorphism: los mismos tokens que el panel del servidor
         (LauncherBackEnd/Panel/static/panel.css), traducidos a WPF.
         Cristal oscuro con desenfoque alto sobre el fondo del launcher.
         Estilo "glass de escritorio": ventana de cristal azul pizarra, líneas
         finas en lugar de huecos, botones de esquinas redondeadas y pestañas subrayadas.
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- Tipografía: Segoe UI Variable en Windows 11, Segoe UI en Windows 10 -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <!-- Iconos minimalistas del sistema (Windows 11 / Windows 10) -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Tinta -->
    <SolidColorBrush x:Key="Ink" Color="#F3F5F7" />
    <SolidColorBrush x:Key="Ink2" Color="#BDF3F5F7" />
    <!-- 60 %: con el fondo más claro detrás del cristal sigue por encima de 4.5:1 -->
    <SolidColorBrush x:Key="Ink3" Color="#99F3F5F7" />

    <!-- Cristal -->
    <SolidColorBrush x:Key="GlassTint" Color="#94101418" />
    <SolidColorBrush x:Key="GlassStroke" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Scrim" Color="#59060810" />
    <SolidColorBrush x:Key="ModalScrim" Color="#8C04060A" />

    <!-- Superficies dentro del cristal -->
    <SolidColorBrush x:Key="Surface" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="SurfaceHover" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="SurfaceSunken" Color="#38000000" />

    <!-- Ventana de cristal: tinte azul pizarra frío (no negro puro); la barra lateral, algo más oscura -->
    <SolidColorBrush x:Key="WindowTint" Color="#B81B1F2C" />
    <SolidColorBrush x:Key="SidebarTint" Color="#C4151925" />
    <SolidColorBrush x:Key="SidebarShade" Color="#26000000" />
    <SolidColorBrush x:Key="HeaderTint" Color="#14FFFFFF" />
    <!-- Líneas de 1 px que separan barra lateral, cabecera, filas y pies de tarjeta -->
    <SolidColorBrush x:Key="Hairline" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="HairlineStrong" Color="#24FFFFFF" />
    <!-- Contenedores dentro del cristal (listas agrupadas y tarjetas) -->
    <SolidColorBrush x:Key="Group" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="RowHover" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="RowSelected" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="InstanceSelected" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="PillGhost" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="PillGhostHover" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="PillOutline" Color="#8CFFFFFF" />
    <SolidColorBrush x:Key="TileBackground" Color="#F20B0E14" />
    <!-- Menús contextuales y descripciones emergentes: cristal denso -->
    <SolidColorBrush x:Key="MenuGlass" Color="#E61A1E2A" />
    <!-- Diálogos: el mismo cristal azul pizarra de la ventana, más denso para que se lea bien encima -->
    <SolidColorBrush x:Key="DialogTint" Color="#D91B1F2C" />
    <!-- Avisos de estado dentro de los diálogos: verde = sincronizado/listo; rojo = zona de peligro -->
    <SolidColorBrush x:Key="OkSoft" Color="#1F4FD18B" />
    <SolidColorBrush x:Key="OkLine" Color="#5927AE60" />
    <SolidColorBrush x:Key="DangerTint" Color="#12FF6B6B" />
    <!-- Cerrar la ventana, al pasar el ratón -->
    <SolidColorBrush x:Key="CloseHover" Color="#E6E5484D" />

    <!-- Campo sin borde de la cabecera (búsqueda) -->
    <SolidColorBrush x:Key="FieldQuiet" Color="#1F000000" />
    <SolidColorBrush x:Key="FieldQuietHover" Color="#33000000" />
    <SolidColorBrush x:Key="AvatarRing" Color="#33FFFFFF" />
    <!-- Aurora del fondo: manchas de color saturado (de opaco a transparente) que tiñen el cristal -->
    <RadialGradientBrush x:Key="AuroraBlue">
        <GradientStop Color="#FF3A5BFF" Offset="0" />
        <GradientStop Color="#003A5BFF" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="AuroraViolet">
        <GradientStop Color="#FF8E3BFF" Offset="0" />
        <GradientStop Color="#008E3BFF" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="AuroraRed">
        <GradientStop Color="#FFFF2E63" Offset="0" />
        <GradientStop Color="#00FF2E63" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="AuroraCyan">
        <GradientStop Color="#FF1FB6FF" Offset="0" />
        <GradientStop Color="#001FB6FF" Offset="1" />
    </RadialGradientBrush>

    <!-- Acento y marca. Para volver al verde en toda la interfaz basta con poner los valores de Brand
         en Accent/AccentHover/AccentPress/AccentSoft.
         - Accent (azul): interfaz general — botones, insignias, selección, foco, interruptores.
         - Brand (verde del launcher): solo JUGAR, barras de progreso y el estado "lista/actualizada". -->
    <SolidColorBrush x:Key="Accent" Color="#3478F6" />
    <SolidColorBrush x:Key="AccentHover" Color="#4A88FF" />
    <SolidColorBrush x:Key="AccentPress" Color="#2563D9" />
    <SolidColorBrush x:Key="AccentSoft" Color="#263478F6" />
    <SolidColorBrush x:Key="Brand" Color="#27AE60" />
    <SolidColorBrush x:Key="BrandPress" Color="#1E8449" />
    <SolidColorBrush x:Key="Ok" Color="#4FD18B" />
    <SolidColorBrush x:Key="Warn" Color="#F5B041" />
    <SolidColorBrush x:Key="Danger" Color="#FF6B6B" />
    <SolidColorBrush x:Key="DangerSoft" Color="#24FF6B6B" />
    <SolidColorBrush x:Key="DangerStroke" Color="#8CFF6B6B" />

    <!-- Color de cada cargador (borde y letras del icono de una instancia) -->
    <SolidColorBrush x:Key="LoaderVanilla" Color="#7AE08A" />
    <SolidColorBrush x:Key="LoaderFabric" Color="#DBB68F" />
    <SolidColorBrush x:Key="LoaderForge" Color="#E0743A" />
    <SolidColorBrush x:Key="LoaderNeoForge" Color="#F0A040" />
    <SolidColorBrush x:Key="LoaderQuilt" Color="#C77DFF" />

    <CornerRadius x:Key="RadiusControl">10</CornerRadius>
    <!-- Botones, campos de selección y filtros: rectángulos con las esquinas redondeadas (como Modrinth) -->
    <CornerRadius x:Key="RadiusButton">10</CornerRadius>
    <!-- Etiquetas pequeñas (cargador, tipo de versión...) -->
    <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
    <CornerRadius x:Key="RadiusRow">8</CornerRadius>
    <CornerRadius x:Key="RadiusGroup">12</CornerRadius>
    <CornerRadius x:Key="RadiusTile">7</CornerRadius>
    <sys:Double x:Key="ControlHeight">38</sys:Double>
    <sys:Double x:Key="PillHeight">34</sys:Double>

    <!-- Duración de las transiciones. Con las animaciones de Windows desactivadas
         (SystemParameters.ClientAreaAnimation = false) los estilos cambian de estado sin transición.
         Ojo: en ControlTemplate.Triggers, los DataTrigger se evalúan sobre el propio control, así que
         sus enlaces usan RelativeSource Self (TemplatedParent no apuntaría a nada). -->
    <Duration x:Key="MotionFast">0:0:0.08</Duration>
    <Duration x:Key="MotionNormal">0:0:0.15</Duration>
    <Duration x:Key="MotionDialog">0:0:0.16</Duration>

    <!-- Glifos (Segoe Fluent Icons / MDL2 Assets) -->
    <sys:String x:Key="IconSettings">&#xE713;</sys:String>
    <sys:String x:Key="IconAdd">&#xE710;</sys:String>
    <sys:String x:Key="IconPlay">&#xE768;</sys:String>
    <sys:String x:Key="IconFolder">&#xED25;</sys:String>
    <sys:String x:Key="IconDelete">&#xE74D;</sys:String>
    <sys:String x:Key="IconChevronDown">&#xE70D;</sys:String>
    <sys:String x:Key="IconClose">&#xE8BB;</sys:String>
    <sys:String x:Key="IconMinimize">&#xE921;</sys:String>
    <sys:String x:Key="IconSync">&#xE895;</sys:String>
    <sys:String x:Key="IconCheck">&#xE73E;</sys:String>
    <sys:String x:Key="IconSearch">&#xE721;</sys:String>
    <sys:String x:Key="IconCube">&#xF158;</sys:String>
    <sys:String x:Key="IconMaximize">&#xE922;</sys:String>

    <!-- Panel de cristal (estilo implícito: cualquier GlassPanel lo usa) -->
    <Style TargetType="c:GlassPanel">
        <Setter Property="Background" Value="{StaticResource GlassTint}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:GlassPanel">
                    <Grid x:Name="PART_Root">
                        <!-- El fondo ya desenfocado se guarda como imagen (BitmapCache en el contenedor, así incluye
                             el desenfoque): lo que se anima encima (la vista 3D) no obliga a recalcular el
                             desenfoque en cada fotograma. Solo se rehace si cambia el fondo o el tamaño. -->
                        <Grid IsHitTestVisible="False">
                            <Grid.CacheMode>
                                <BitmapCache EnableClearType="False" SnapsToDevicePixels="False" />
                            </Grid.CacheMode>
                            <Rectangle x:Name="PART_Backdrop" IsHitTestVisible="False" />
                        </Grid>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Páginas (secciones de la barra lateral) ═══
         Al cambiar de sección, la página aparece con un fundido y sube 10 px en 180 ms (sin transición si
         Windows tiene las animaciones desactivadas). -->
    <Duration x:Key="MotionPage">0:0:0.18</Duration>
    <Style x:Key="PageTransition" TargetType="Border">
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="{StaticResource MotionPage}">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="10" To="0"
                                             Duration="{StaticResource MotionPage}">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ═══ Diálogos (overlays) ═══
         Mismo cristal que la ventana (más denso), radio 16 y una línea clara de borde. Al aparecer: fundido
         y escala 0.96 → 1 en 160 ms (sin transición si Windows tiene las animaciones desactivadas). -->
    <Style x:Key="DialogGlass" TargetType="c:GlassPanel" BasedOn="{StaticResource {x:Type c:GlassPanel}}">
        <Setter Property="Background" Value="{StaticResource DialogTint}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineStrong}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="{StaticResource MotionDialog}">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.96" To="1"
                                             Duration="{StaticResource MotionDialog}">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.96" To="1"
                                             Duration="{StaticResource MotionDialog}">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ═══ Texto ═══ -->
    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Ink2}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Ink3}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ═══ Foco de teclado (común) ═══
         Anillo de 2 px del acento, solo al navegar con el teclado. Uno por radio para que siga la
         forma del control: botones y controles de radio 10, y filas de radio 8. -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderBrush="{StaticResource Accent}" BorderThickness="2" CornerRadius="13"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Filas a todo el ancho (lista de instancias): el anillo va por dentro -->
    <Style x:Key="FocusRingInset">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="3" BorderBrush="{StaticResource Accent}" BorderThickness="2" CornerRadius="6"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FocusRingRow">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" BorderBrush="{StaticResource Accent}" BorderThickness="2" CornerRadius="10"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Botones ═══ -->
    <!-- Base de todos los botones: forma, contenido y pulsación (escala 0.97). Los colores los ponen
         los estilos de abajo con sus propios disparadores. -->
    <ControlTemplate x:Key="PillTemplate" TargetType="ButtonBase">
        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusButton}"
                Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
            <Border.RenderTransform>
                <ScaleTransform />
            </Border.RenderTransform>
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
        </Border>
        <ControlTemplate.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="0.97" Duration="{StaticResource MotionFast}" />
                            <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="0.97" Duration="{StaticResource MotionFast}" />
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1" Duration="{StaticResource MotionFast}" />
                            <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1" Duration="{StaticResource MotionFast}" />
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.ExitActions>
            </MultiDataTrigger>
            <!-- Sin animaciones en Windows: la misma escala, sin transición -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Bd" Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                    </Setter.Value>
                </Setter>
            </MultiDataTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="PillBase" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Height" Value="{StaticResource PillHeight}" />
        <Setter Property="Padding" Value="22,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template" Value="{StaticResource PillTemplate}" />
    </Style>

    <!-- Botón relleno (acción principal): acento azul -->
    <Style x:Key="PillButton" TargetType="ButtonBase" BasedOn="{StaticResource PillBase}">
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="Foreground" Value="White" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentPress}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Botón tenue, sin borde (acciones secundarias) -->
    <Style x:Key="PillGhostButton" TargetType="ButtonBase" BasedOn="{StaticResource PillBase}">
        <Setter Property="Background" Value="{StaticResource PillGhost}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PillGhostHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Estilos de siempre con el aspecto nuevo: todas las vistas cambian sin tocarlas.
         Mantienen el alto de 38 para no mover lo que ya está maquetado. -->

    <!-- Secundario: botón tenue con un borde muy fino -->
    <Style x:Key="GlassButton" TargetType="ButtonBase" BasedOn="{StaticResource PillGhostButton}">
        <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="{StaticResource ControlHeight}" />
        <Setter Property="Padding" Value="18,0" />
    </Style>

    <!-- Principal: relleno del acento -->
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Height" Value="{StaticResource ControlHeight}" />
    </Style>

    <!-- Destructivo: con el rojo suave -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
        <Setter Property="Background" Value="{StaticResource DangerSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource DangerStroke}" />
        <Setter Property="Foreground" Value="#FFD6D6" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#40FF6B6B" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Terciario: solo texto (fondo tenue al pasar el ratón) -->
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Ink2}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PillGhost}" />
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Botón redondo de icono (⋯, cerrar un panel...) -->
    <Style x:Key="IconOnlyButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="#0FFFFFFF" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Ink2}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══ JUGAR: botón grande con el verde del launcher (degradado vertical y brillo arriba) ═══ -->
    <LinearGradientBrush x:Key="PlayGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#34C472" Offset="0" />
        <GradientStop Color="#219A54" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PlayGradientHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3ED57F" Offset="0" />
        <GradientStop Color="#27AE60" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PlayShine" Color="#40FFFFFF" />
    <Style x:Key="GlassPlayButton" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform />
                        </Grid.RenderTransform>
                        <Border x:Name="Bd" Background="{StaticResource PlayGradient}" CornerRadius="{StaticResource RadiusButton}" />
                        <!-- Brillo interior de 1 px en el borde superior -->
                        <Border x:Name="Shine" CornerRadius="{StaticResource RadiusButton}" BorderThickness="0,1,0,0"
                                BorderBrush="{StaticResource PlayShine}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="Glyph" Text="{StaticResource IconPlay}" FontFamily="{StaticResource IconFont}"
                                       FontSize="17" FontWeight="Normal" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PlayGradientHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandPress}" />
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.98" ScaleY="0.98" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- Deshabilitado (verificando / jugando): el verde apagado -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#4D27AE60" />
                            <Setter TargetName="Shine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Foreground" Value="#D9FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Grupos de botones (cargador, canal): RadioButton con aspecto de segmento ═══ -->
    <Style x:Key="SegmentButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Ink2}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{StaticResource Surface}" BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="9" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}" />
                            <Setter Property="Foreground" Value="{StaticResource Ink}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource Ink}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Barra desplegable (selector de versión): barra horizontal que se abre al pulsarla ═══ -->
    <Style x:Key="DropdownBar" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{StaticResource FieldQuiet}" BorderBrush="Transparent"
                            BorderThickness="1.5" CornerRadius="{StaticResource RadiusControl}" Padding="14,0,12,0">
                        <DockPanel>
                            <TextBlock x:Name="Chevron" DockPanel.Dock="Right" Text="{StaticResource IconChevronDown}"
                                       Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Ink2}"
                                       RenderTransformOrigin="0.5,0.5" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource FieldQuietHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180" /></Setter.Value></Setter>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Elemento de una lista desplegada -->
    <Style x:Key="ListOption" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="12,0">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Campos ═══
         Sin borde en reposo, fondo oscuro tenue y radio 8; con foco, borde de 1.5 px del acento y el fondo
         un poco más claro. -->
    <Style x:Key="GlassTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{StaticResource FieldQuiet}" BorderBrush="Transparent"
                            BorderThickness="1.5" CornerRadius="8">
                        <Grid>
                            <!-- Texto de ayuda (Tag) cuando está vacío -->
                            <!-- +2 px: el cuadro de texto deja ese hueco para el cursor -->
                            <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="{StaticResource Ink3}"
                                       Padding="{TemplateBinding Padding}" Margin="2,0,0,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" IsHitTestVisible="False"
                                       Visibility="Collapsed" TextTrimming="CharacterEllipsis" />
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource FieldQuietHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Group}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Interruptor (CheckBox): acento = activo -->
    <Style x:Key="SwitchCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <DockPanel Background="Transparent">
                        <Border x:Name="Track" DockPanel.Dock="Right" Width="38" Height="22" CornerRadius="11"
                                Background="#2EFFFFFF" VerticalAlignment="Center" Margin="16,0,0,0" BorderThickness="1.5" BorderBrush="Transparent">
                            <Ellipse x:Name="Knob" Width="17" Height="17" Fill="White" HorizontalAlignment="Left" Margin="1,0,0,0" />
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}" />
                            <Setter TargetName="Knob" Property="RenderTransform"><Setter.Value><TranslateTransform X="15" /></Setter.Value></Setter>
                        </Trigger>
                        <!-- Foco de teclado: anillo del acento alrededor de la pista -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Barra de progreso fina, sin degradado: verde del launcher (Brand) -->
    <Style x:Key="GlassProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="#1AFFFFFF" CornerRadius="3" />
                        <Border x:Name="PART_Indicator" Background="{StaticResource Brand}" CornerRadius="3" HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Barra de desplazamiento fina y discreta -->
    <Style x:Key="ThinScrollBarThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="T" Background="#4DC8D2DC" CornerRadius="3" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Background" Value="#99E6EBF0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GlassScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="6" />
        <Setter Property="MinWidth" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ThinScrollBarThumb}" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <ControlTemplate x:Key="GlassScrollViewer" TargetType="ScrollViewer">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ScrollContentPresenter Grid.Column="0" CanContentScroll="{TemplateBinding CanContentScroll}" />
            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Style="{StaticResource GlassScrollBar}" Margin="6,2,0,2"
                       Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}"
                       ViewportSize="{TemplateBinding ViewportHeight}"
                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
        </Grid>
    </ControlTemplate>

    <!-- Elemento de la lista de instancias (barra lateral), como una lista de chats: fila de 72 px a todo
         el ancho, sin márgenes laterales y separada de la anterior por una línea fina (la primera no
         lleva). Seleccionada: un velo claro de lado a lado. -->
    <Style x:Key="InstanceListItem" TargetType="ListBoxItem">
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="72" />
        <Setter Property="Padding" Value="24,0,14,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingInset}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource InstanceSelected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                <Setter Property="BorderThickness" Value="0" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Dato de la cabecera (versión, cargador, servidor, memoria): solo texto e icono, sin fondo -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0,4" />
        <Setter Property="Margin" Value="0,0,20,0" />
    </Style>

    <!-- ═══ Deslizador (memoria): pista fina, relleno del acento y tirador blanco ═══ -->
    <Style x:Key="SliderFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="6" CornerRadius="3" Background="{StaticResource Accent}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SliderEmpty" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SliderThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse x:Name="Knob" Width="20" Height="20" Fill="White" Stroke="{StaticResource Accent}" StrokeThickness="3"
                             RenderTransformOrigin="0.5,0.5" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.15" ScaleY="1.15" /></Setter.Value></Setter>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Knob" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.15" ScaleY="1.15" /></Setter.Value></Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GlassSlider" TargetType="Slider">
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border x:Name="Rail" Height="6" CornerRadius="3" Background="#1FFFFFFF" BorderThickness="1" BorderBrush="Transparent" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderFill}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderEmpty}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Rail" Property="BorderBrush" Value="{StaticResource AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         Piezas del estilo "glass de escritorio" (las usan la ventana, la barra
         lateral, las vistas y los overlays en las fases siguientes)
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- ═══ Texto ═══ -->
    <!-- Título de la vista o de la instancia: grande y ligero -->
    <Style x:Key="ViewTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- Etiqueta de un grupo de la barra lateral ("Instancias", "Cuenta") -->
    <Style x:Key="SidebarGroupLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Ink3}" />
        <Setter Property="Margin" Value="10,0,0,6" />
    </Style>
    <!-- Etiqueta encima de una lista agrupada ("Instalado") -->
    <Style x:Key="GroupLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Ink3}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <!-- Descripción de una tarjeta -->
    <Style x:Key="CardText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource Ink2}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- ═══ Pestañas con subrayado ═══
         RadioButton. Texto Ink3 (Ink la activa) y un subrayado blanco de 2 px pegado al borde inferior,
         del ancho del texto + 16 px (el Padding). Tag = true muestra un punto de novedades.
         Se estira en vertical: así el subrayado queda sobre la línea de la cabecera. -->
    <Style x:Key="TopTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Ink3}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingRow}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                            <ContentPresenter RecognizesAccessKey="True" />
                            <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{StaticResource Accent}" HorizontalAlignment="Right"
                                     VerticalAlignment="Top" Margin="0,0,-8,0" Visibility="Collapsed" />
                        </Grid>
                        <Border x:Name="Underline" Height="2" CornerRadius="1" Background="White" VerticalAlignment="Bottom"
                                Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="0.6" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Ink2}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Ink}" />
                        </Trigger>
                        <Trigger Property="Tag">
                            <Trigger.Value>
                                <sys:Boolean>True</sys:Boolean>
                            </Trigger.Value>
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Underline" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource MotionNormal}" />
                                        <DoubleAnimation Storyboard.TargetName="Underline" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1" Duration="{StaticResource MotionNormal}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Underline" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource MotionNormal}" />
                                        <DoubleAnimation Storyboard.TargetName="Underline" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="0.6" Duration="{StaticResource MotionNormal}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Underline" Property="Opacity" Value="1" />
                            <Setter TargetName="Underline" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1" />
                                </Setter.Value>
                            </Setter>
                        </MultiDataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Subpestañas (subcabecera: Modpacks / Mods / Paquetes de recursos…) -->
    <Style x:Key="TopTabSmall" TargetType="RadioButton" BasedOn="{StaticResource TopTab}">
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- ═══ Barra lateral ═══
         SidebarAction (Button) y SidebarItem (RadioButton/ToggleButton, con estado seleccionado):
         alto 38, icono + texto 15 compuestos en la vista. -->
    <Style x:Key="SidebarAction" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{StaticResource Ink2}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingRow}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusRow}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource RowHover}" />
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══ Insignias y puntos de estado ═══ -->
    <!-- Contador (barra lateral): círculo de 18 px del acento con el número de 11 px -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="MinWidth" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextElement.Foreground" Value="White" />
        <Setter Property="TextElement.FontSize" Value="11" />
        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
    </Style>
    <!-- Punto de estado de una fila ("● Actualizada"): el color lo pone la vista (Ok, Accent...) -->
    <Style x:Key="StatusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="Fill" Value="{StaticResource Ok}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Punto en la esquina de un icono (lista de instancias): 10 px y anillo de 2 px del color del fondo -->
    <Style x:Key="PresenceDot" TargetType="Ellipse">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="Stroke" Value="{StaticResource SidebarTint}" />
        <Setter Property="Fill" Value="{StaticResource Ok}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="0,0,-3,-3" />
    </Style>

    <!-- ═══ Icono de instancia o proyecto ═══
         Cuadrado oscuro con el borde y las letras del color del cargador (LoaderFabric...). -->
    <Style x:Key="IconTile" TargetType="Border">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusTile}" />
        <Setter Property="Background" Value="{StaticResource TileBackground}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="BorderBrush" Value="{StaticResource Ink3}" />
        <Setter Property="TextElement.FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="TextElement.FontSize" Value="13" />
        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ═══ Lista agrupada ═══
         GroupedList: contenedor redondeado. GroupedRow: fila de 58 px con una línea fina encima;
         la primera fila usa GroupedRowFirst (sin línea). -->
    <Style x:Key="GroupedList" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusGroup}" />
        <Setter Property="Background" Value="{StaticResource Group}" />
        <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="GroupedRow" TargetType="Border">
        <Setter Property="MinHeight" Value="58" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- Fila de una lista generada (ItemsControl): sin línea encima si es la primera -->
    <Style x:Key="GroupedItemRow" TargetType="Border" BasedOn="{StaticResource GroupedRow}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                <Setter Property="BorderThickness" Value="0" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ═══ Cifras ═══ celdas de un bloque agrupado (UniformGrid), separadas por una línea vertical -->
    <Style x:Key="StatCell" TargetType="Border">
        <Setter Property="Padding" Value="18,14" />
        <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
    </Style>
    <Style x:Key="StatLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Ink3}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="StatValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>

    <!-- ═══ Tarjeta ═══ (rejilla de resultados, instancias vacías). El pie va en CardFooter. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusGroup}" />
        <Setter Property="Background" Value="{StaticResource Group}" />
        <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="22" />
    </Style>
    <Style x:Key="CardFooter" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Margin" Value="0,18,0,0" />
        <Setter Property="Padding" Value="0,14,0,0" />
    </Style>

    <!-- ═══ Controles de la ventana (minimizar, maximizar, cerrar) ═══
         Cuadrados de cristal de 32 px (radio 10) con el glifo de Segoe Fluent; al pasar el ratón, el velo
         de los botones tenues. Cerrar se vuelve rojo. No reciben el foco (como los de cualquier ventana). -->
    <Style x:Key="WindowCaptionButton" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Ink2}" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusButton}"
                            RenderTransformOrigin="0.5,0.5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.94" ScaleY="0.94" /></Setter.Value></Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Ventana inactiva: más tenues -->
            <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Ink3}" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PillGhostHover}" />
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="WindowCloseCaptionButton" TargetType="Button" BasedOn="{StaticResource WindowCaptionButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource CloseHover}" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══ Menú contextual (⋯) ═══ cristal denso, radio 8, filas con fondo al pasar el ratón -->
    <Style x:Key="GlassMenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,7" MinWidth="180">
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter x:Name="IconHost" ContentSource="Icon" Width="16" Margin="0,0,10,0" VerticalAlignment="Center"
                                              TextElement.FontFamily="{StaticResource IconFont}" TextElement.FontSize="13"
                                              TextElement.Foreground="{StaticResource Ink2}" />
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowSelected}" />
                        </Trigger>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GlassContextMenu" TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource GlassMenuItem}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <!-- Margen para que la sombra quepa dentro del popup -->
                    <Border Margin="0,0,10,12" Background="{StaticResource MenuGlass}" BorderBrush="{StaticResource HairlineStrong}"
                            BorderThickness="1" CornerRadius="8" Padding="6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" Opacity="0.4" ShadowDepth="4" Direction="270" />
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Descripción emergente (ToolTip) de toda la aplicación ═══ cristal denso, radio 8 -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource MenuGlass}" BorderBrush="{StaticResource HairlineStrong}" BorderThickness="1"
                            CornerRadius="8" Padding="10,6" Margin="0,0,8,10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" Opacity="0.35" ShadowDepth="3" Direction="270" />
                        </Border.Effect>
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Cualquier menú contextual (también el de copiar/pegar de los campos) usa el de cristal -->
    <Style TargetType="ContextMenu" BasedOn="{StaticResource GlassContextMenu}" />
</ResourceDictionary>
