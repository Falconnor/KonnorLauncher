<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.17763 (Windows 10 1809): lo necesita el control de composición de WebView2 (página de los proyectos de Modrinth) -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <!-- La documentación XML de los paquetes (WebView2) no se instala con el launcher -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <UseWPF>true</UseWPF>
    <!-- Nombre del exe: "Konnor Launcher.exe" (el instalador elimina el antiguo "Fkonnor Launcher.exe") -->
    <AssemblyName>Konnor Launcher</AssemblyName>
    <RootNamespace>KonnorLauncher.App</RootNamespace>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
    <!-- LibraryImport (P/Invoke generado) requiere código unsafe -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Assets del launcher, incrustados como recursos WPF -->
    <Resource Include="Assets\background.png" />
    <Resource Include="Assets\icon.png" />
    <Resource Include="Assets\icon.ico" />
    <Resource Include="Assets\steve.png" />
    <!-- Configuración por defecto que se distribuye junto al exe (fuera del single-file) -->
    <Content Include="launcher.properties" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KonnorLauncher.Core\KonnorLauncher.Core.csproj" />
  </ItemGroup>

  <!-- SkiaSharp trae el .pdb de su librería nativa (unos 96 MB): no se publica -->
  <Target Name="QuitarPdbNativos" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

</Project>
