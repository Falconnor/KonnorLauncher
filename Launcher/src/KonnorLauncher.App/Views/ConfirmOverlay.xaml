<UserControl x:Class="KonnorLauncher.App.Views.ConfirmOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:KonnorLauncher.App.ViewModels"
             xmlns:c="clr-namespace:KonnorLauncher.App.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ConfirmViewModel}"
             IsVisibleChanged="OnIsVisibleChanged">
    <!-- Diálogo de confirmación propio del launcher -->
    <Grid Background="{StaticResource ModalScrim}">
        <c:GlassPanel Width="480" Padding="28,24" VerticalAlignment="Center" Background="{StaticResource GlassTintStrong}">
            <StackPanel KeyboardNavigation.TabNavigation="Cycle">
                <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" FontSize="20" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Message}" Foreground="{StaticResource Ink2}" FontSize="14" TextWrapping="Wrap"
                           LineHeight="21" Margin="0,12,0,24" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- En una acción destructiva el foco empieza en Cancelar: Intro no borra nada por accidente -->
                    <Button x:Name="CancelButton" Style="{StaticResource GlassButton}" Content="Cancelar" Margin="0,0,10,0"
                            Command="{Binding CancelCommand}" IsCancel="True" />
                    <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                        <Setter Property="Background" Value="#D9E5484D" />
                                        <Setter Property="BorderBrush" Value="#E5484D" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </StackPanel>
        </c:GlassPanel>
    </Grid>
</UserControl>
