<UserControl x:Class="KonnorLauncher.App.Views.BrowseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:KonnorLauncher.App.ViewModels"
             xmlns:conv="clr-namespace:KonnorLauncher.App.Converters"
             xmlns:c="clr-namespace:KonnorLauncher.App.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BrowseViewModel}">
    <UserControl.Resources>
        <conv:TextToVisibilityConverter x:Key="TextToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:ZeroToVisibleConverter x:Key="ZeroToVisible" />

        <!-- ── Superficies: las del estilo de la ventana (contenedor agrupado y líneas finas) ── -->
        <SolidColorBrush x:Key="GlassFill" Color="#0AFFFFFF" />
        <SolidColorBrush x:Key="GlassFillHover" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="GlassEdge" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="GlassEdgeHover" Color="#24FFFFFF" />
        <SolidColorBrush x:Key="InnerFill" Color="#0AFFFFFF" />
        <SolidColorBrush x:Key="InnerStroke" Color="#14FFFFFF" />
        <!-- Selección y estados activos: gris claro, como la fila elegida de la barra lateral (sin azul ni borde
             marcado). El verde queda para "instalado" y los avisos de éxito. -->
        <SolidColorBrush x:Key="SelectedFill" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="SelectedStroke" Color="#00FFFFFF" />
        <!-- Más claro: para lo que ya tiene fondo gris en reposo (pastillas, número de página, botón Instalar) -->
        <SolidColorBrush x:Key="SelectedFillStrong" Color="#38FFFFFF" />
        <SolidColorBrush x:Key="HoverFillStrong" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="OkFill" Color="#1427AE60" />
        <SolidColorBrush x:Key="OkStroke" Color="#4D27AE60" />
        <DropShadowEffect x:Key="PanelShadow" Color="#020617" BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.45" />

        <!-- ── Select: "Ordenar por: Relevancia ▾", integrado con el fondo (sin caja) ── -->
        <Style x:Key="GlassSelect" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource Ink2}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource RadiusButton}" Padding="2,0,8,0">
                            <DockPanel>
                                <TextBlock x:Name="Chevron" DockPanel.Dock="Right" Text="{StaticResource IconChevronDown}" Style="{StaticResource Icon}"
                                           FontSize="10" Margin="10,0,0,0" Foreground="{StaticResource Ink3}" RenderTransformOrigin="0.5,0.5" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                                <Setter TargetName="Chevron" Property="Foreground" Value="{StaticResource Ink}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                                <Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180" /></Setter.Value></Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Menú de un select -->
        <Style x:Key="MenuPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource MenuGlass}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="0,6,12,12" />
            <Setter Property="Effect" Value="{StaticResource PanelShadow}" />
        </Style>

        <!-- ── Filtro (entorno, versión, cargador, contenido incluido); activo, con el acento ── -->
        <Style x:Key="FilterPill" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink2}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource PillGhost}" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusButton}" Padding="12,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PillGhostHover}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedFillStrong}" />
                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                            </DataTrigger>
                            <!-- Fijada por un servidor de Hosting: no se puede cambiar -->
                            <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter Property="ToolTip" Value="Lo fija el servidor en el que se instala" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsLocked}" Value="True" />
                                    <Condition Binding="{Binding IsActive}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Opacity" Value="0.35" />
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="FilterPillTemplate" DataType="{x:Type vm:FilterOption}">
            <Button Style="{StaticResource FilterPill}" Content="{Binding Label}" Command="{Binding ToggleCommand}"
                    AutomationProperties.Name="{Binding Label}" />
        </DataTemplate>

        <ItemsPanelTemplate x:Key="WrapItems">
            <WrapPanel />
        </ItemsPanelTemplate>
        <!-- Dos columnas del mismo ancho: los filtros quedan alineados -->
        <ItemsPanelTemplate x:Key="TwoColumns">
            <UniformGrid Columns="2" />
        </ItemsPanelTemplate>

        <!-- "Más cargadores ▾" / "Menos cargadores ▴" -->
        <Style x:Key="MoreToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource Ink3}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="2,2,0,0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingRow}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <TextBlock x:Name="Text" Text="Más cargadores" VerticalAlignment="Center" />
                            <TextBlock x:Name="Chevron" Text="{StaticResource IconChevronDown}" Style="{StaticResource Icon}" FontSize="9"
                                       Margin="6,1,0,0" RenderTransformOrigin="0.5,0.5" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Text" Property="Text" Value="Menos cargadores" />
                                <Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180" /></Setter.Value></Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Cabecera plegable de un grupo del panel de filtros ── -->
        <Style x:Key="GroupHeader" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingRow}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" Padding="2,12,2,10">
                            <DockPanel>
                                <TextBlock x:Name="Chevron" DockPanel.Dock="Right" Text="{StaticResource IconChevronDown}" Style="{StaticResource Icon}"
                                           FontSize="10" Foreground="{StaticResource Ink3}" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                                    <TextBlock.RenderTransform><RotateTransform Angle="-90" /></TextBlock.RenderTransform>
                                </TextBlock>
                                <ContentPresenter VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="0" /></Setter.Value></Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chevron" Property="Foreground" Value="{StaticResource Ink}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Botón Instalar: de contorno; con el ratón sobre la tarjeta, relleno gris claro (más claro sobre el botón).
             Instalado: verde (estado "listo"). ── -->
        <Style x:Key="InstallButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource PillOutline}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="130" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.2"
                                CornerRadius="{StaticResource RadiusButton}" Padding="18,0" RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97" /></Setter.Value></Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Con el ratón sobre la tarjeta (o la fila) -->
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverFillStrong}" />
                    <Setter Property="BorderBrush" Value="{StaticResource HoverFillStrong}" />
                    <Setter Property="Foreground" Value="{StaticResource Ink}" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectedFillStrong}" />
                    <Setter Property="BorderBrush" Value="{StaticResource SelectedFillStrong}" />
                    <Setter Property="Foreground" Value="{StaticResource Ink}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="{StaticResource InnerStroke}" />
                    <Setter Property="Foreground" Value="{StaticResource Ink3}" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- El de las tarjetas: además, el estado del proyecto (instalado: verde apagado, con su marca) -->
        <Style x:Key="CardInstallButton" TargetType="Button" BasedOn="{StaticResource InstallButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Installed">
                    <Setter Property="Background" Value="{StaticResource OkFill}" />
                    <Setter Property="BorderBrush" Value="{StaticResource OkStroke}" />
                    <Setter Property="Foreground" Value="{StaticResource Ok}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ── Etiqueta de la tarjeta, con el color de su cargador ── -->
        <DataTemplate x:Key="CardTagTemplate" DataType="{x:Type vm:CardTag}">
            <Border x:Name="Bd" Background="{StaticResource InnerFill}" BorderBrush="{StaticResource InnerStroke}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusSmall}" Padding="9,2" Margin="0,0,6,0">
                <TextBlock x:Name="Text" Text="{Binding Text}" FontSize="12.5" Foreground="{StaticResource Ink2}" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="fabric">
                    <Setter TargetName="Bd" Property="Background" Value="#14DBB68F" />
                    <Setter TargetName="Bd" Property="BorderBrush" Value="#4DDBB68F" />
                    <Setter TargetName="Text" Property="Foreground" Value="{StaticResource LoaderFabric}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="quilt">
                    <Setter TargetName="Bd" Property="Background" Value="#14C77DFF" />
                    <Setter TargetName="Bd" Property="BorderBrush" Value="#4DC77DFF" />
                    <Setter TargetName="Text" Property="Foreground" Value="{StaticResource LoaderQuilt}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="forge">
                    <Setter TargetName="Bd" Property="Background" Value="#14E0743A" />
                    <Setter TargetName="Bd" Property="BorderBrush" Value="#4DE0743A" />
                    <Setter TargetName="Text" Property="Foreground" Value="{StaticResource LoaderForge}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="neoforge">
                    <Setter TargetName="Bd" Property="Background" Value="#14F0A040" />
                    <Setter TargetName="Bd" Property="BorderBrush" Value="#4DF0A040" />
                    <Setter TargetName="Text" Property="Foreground" Value="{StaticResource LoaderNeoForge}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="env">
                    <Setter TargetName="Text" Property="Foreground" Value="{StaticResource Ink}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="more">
                    <Setter TargetName="Text" Property="Foreground" Value="{StaticResource Ink3}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Etiqueta pulsable de la columna de compatibilidad: muestra los archivos de esa versión o cargador -->
        <Style x:Key="CompatChipButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Ring" BorderThickness="1" BorderBrush="Transparent" CornerRadius="7" Padding="1" Background="Transparent">
                            <ContentPresenter x:Name="Content" Opacity="0.92" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Content" Property="Opacity" Value="1" />
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource InnerStroke}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Content" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Content" Property="Opacity" Value="1" />
                                <Setter TargetName="Ring" Property="Background" Value="{StaticResource SelectedFillStrong}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Tarjeta: contenedor agrupado (radio 12) que se aclara con el ratón ── -->
        <Style x:Key="ProjectCardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GlassFill}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassEdge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusGroup}" />
            <Setter Property="Padding" Value="16" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource GlassFillHover}" />
                    <Setter Property="BorderBrush" Value="{StaticResource GlassEdgeHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Paginación: cuadrados redondeados de 34 px; la página actual, en el acento ── -->
        <Style x:Key="PageButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink2}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceHover}" />
                    <Setter Property="Foreground" Value="{StaticResource Ink}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Número de página: la actual, en gris claro (como la fila elegida de la barra lateral) -->
        <Style x:Key="PageNumberButton" TargetType="Button" BasedOn="{StaticResource PageButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectedFillStrong}" />
                    <Setter Property="Foreground" Value="{StaticResource Ink}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Modo compacto (ventana estrecha): lo marca BrowseView.IsCompact -->
        <Style x:Key="WideOnly" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CompactOnly" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Paginador (arriba y debajo de la lista), integrado con el fondo: sin cápsula -->
        <DataTemplate x:Key="Pager" DataType="{x:Type vm:BrowseViewModel}">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PageButton}" Command="{Binding PreviousPageCommand}" AutomationProperties.Name="Página anterior">
                    <TextBlock Text="&#xE76B;" Style="{StaticResource Icon}" FontSize="10" />
                </Button>
                <ItemsControl ItemsSource="{Binding Pages}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PageItem}">
                            <Grid Margin="1,0">
                                <Button Style="{StaticResource PageNumberButton}" Content="{Binding Text}" Command="{Binding GoCommand}"
                                        CommandParameter="{Binding Number}" AutomationProperties.Name="{Binding Text, StringFormat=Página {0}}"
                                        Visibility="{Binding IsEllipsis, Converter={StaticResource InverseBoolToVisibility}}" />
                                <TextBlock Text="…" Width="20" TextAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Ink3}"
                                           Visibility="{Binding IsEllipsis, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource PageButton}" Command="{Binding NextPageCommand}" AutomationProperties.Name="Página siguiente">
                    <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="10" />
                </Button>
            </StackPanel>
        </DataTemplate>

        <!-- Encabezados de grupo (filtros e información del proyecto): ligeros, como en la barra lateral -->
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Ink2}" />
        </Style>
        <Style x:Key="GroupActive" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource AccentHover}" />
            <Setter Property="Margin" Value="10,1,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ 1. Subcabecera: pestañas de tipo, subrayadas sobre una línea fina (el título va en la cabecera) ═══ -->
        <Grid Grid.Row="0" Height="50">
            <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource Hairline}" />
            <DockPanel>
                <!-- Abierto desde Hosting: aviso del servidor en el que se instala, volver a él o salir -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"
                            Visibility="{Binding IsServerMode, Converter={StaticResource BoolToVisibility}}">
                    <Border Background="#1FF5B041" BorderBrush="#59F5B041" BorderThickness="1" CornerRadius="{StaticResource RadiusButton}"
                            Padding="10,5" VerticalAlignment="Center"
                            ToolTip="Lo que instales va a la carpeta del servidor, con su cargador y su versión de Minecraft">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Warn}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ServerTargetText}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Warn}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource QuietButton}" Height="30" FontSize="12.5" Padding="10,0" Margin="6,0,0,0" Content="Volver al servidor"
                            Command="{Binding ReturnToServerCommand}" AutomationProperties.Name="Volver al servidor" />
                    <Button Style="{StaticResource IconOnlyButton}" Width="30" Height="30" FontSize="10" Content="{StaticResource IconClose}"
                            Command="{Binding ExitServerModeCommand}" ToolTip="Dejar de instalar en el servidor"
                            AutomationProperties.Name="Dejar de instalar en el servidor" />
                </StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
                    <ItemsControl ItemsSource="{Binding Tabs}" KeyboardNavigation.TabNavigation="Once">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BrowseTab}">
                                <RadioButton Style="{StaticResource TopTabSmall}" Height="50" GroupName="BrowseTabs" IsChecked="{Binding IsActive}"
                                             AutomationProperties.Name="{Binding Label}" ToolTip="{Binding Label}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                                                <Condition Binding="{Binding IsActive}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition x:Name="FilterColumn" Width="272" />
            </Grid.ColumnDefinitions>

            <!-- ═══ Columna principal ═══ -->
            <DockPanel Grid.Column="0">
                <!-- Aviso de la última instalación (en la lista y en la página del proyecto) -->
                <Border DockPanel.Dock="Bottom" CornerRadius="10" Padding="14,10,8,10" Margin="0,12,0,0" BorderThickness="1"
                        Visibility="{Binding Notice, Converter={StaticResource TextToVisibility}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource OkFill}" />
                            <Setter Property="BorderBrush" Value="{StaticResource OkStroke}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNoticeError}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource DangerSoft}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource DangerStroke}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconOnlyButton}" Width="26" Height="26" FontSize="9"
                                Content="{StaticResource IconClose}" Command="{Binding DismissNoticeCommand}" AutomationProperties.Name="Cerrar aviso" />
                        <TextBlock Text="{Binding Notice}" FontSize="13.5" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <Grid>
                    <!-- ─── Resultados ─── -->
                    <DockPanel Visibility="{Binding HasProject, Converter={StaticResource InverseBoolToVisibility}}">
                        <!-- Búsqueda -->
                        <Border DockPanel.Dock="Top" CornerRadius="10" Height="44" Padding="16,0,9,0" BorderThickness="1.5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource FieldQuiet}" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource FieldQuietHover}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=SearchBox}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                            <Setter Property="Background" Value="{StaticResource Group}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="{StaticResource IconSearch}" Style="{StaticResource Icon}" FontSize="14"
                                           Foreground="{StaticResource Ink3}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Border DockPanel.Dock="Right" Background="{StaticResource InnerFill}" BorderBrush="{StaticResource InnerStroke}" BorderThickness="1"
                                        CornerRadius="6" Width="24" Height="24" VerticalAlignment="Center" ToolTip="Pulsa / para buscar">
                                    <TextBlock Text="/" FontSize="13" Foreground="{StaticResource Ink3}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Grid>
                                    <TextBlock Text="{Binding SearchPlaceholder}" FontSize="15" Foreground="{StaticResource Ink3}" VerticalAlignment="Center"
                                               IsHitTestVisible="False" Margin="2,0,0,0"
                                               Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource TextToVisibility}, ConverterParameter=invert}" />
                                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" FontSize="15"
                                             Background="Transparent" BorderThickness="0" Foreground="{StaticResource Ink}" CaretBrush="{StaticResource Ink}"
                                             SelectionBrush="{StaticResource Accent}" VerticalAlignment="Center" FocusVisualStyle="{x:Null}"
                                             AutomationProperties.Name="Buscar" />
                                </Grid>
                            </DockPanel>
                        </Border>

                        <!-- Barra de herramientas: orden, cantidad, filtros activos y paginación -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,14,0,0">
                            <Grid DockPanel.Dock="Right" Margin="10,0,0,0" Visibility="{Binding HasPages, Converter={StaticResource BoolToVisibility}}">
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Pager}" Focusable="False"
                                                Style="{StaticResource WideOnly}" />
                            </Grid>

                            <Grid DockPanel.Dock="Left">
                                <ToggleButton x:Name="SortToggle" Style="{StaticResource GlassSelect}" IsChecked="{Binding IsSortOpen}" AutomationProperties.Name="Ordenar por">
                                    <TextBlock>
                                        <Run Text="Ordenar por:" /> <Run Text="{Binding SortLabel, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                                    </TextBlock>
                                </ToggleButton>
                                <Popup IsOpen="{Binding IsSortOpen}" PlacementTarget="{Binding ElementName=SortToggle}" Placement="Bottom"
                                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" MinWidth="200">
                                    <Border Style="{StaticResource MenuPanel}">
                                        <ItemsControl ItemsSource="{Binding SortOptions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:SortOption}">
                                                    <Button Style="{StaticResource ListOption}" Content="{Binding Label}"
                                                            Command="{Binding DataContext.ChooseSortCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Value}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Popup>
                            </Grid>

                            <Grid DockPanel.Dock="Left" Margin="8,0,0,0">
                                <ToggleButton x:Name="SizeToggle" Style="{StaticResource GlassSelect}" IsChecked="{Binding IsPageSizeOpen}" AutomationProperties.Name="Resultados por página">
                                    <TextBlock>
                                        <Run Text="Ver:" /> <Run Text="{Binding PageSize, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                                    </TextBlock>
                                </ToggleButton>
                                <Popup IsOpen="{Binding IsPageSizeOpen}" PlacementTarget="{Binding ElementName=SizeToggle}" Placement="Bottom"
                                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" MinWidth="110">
                                    <Border Style="{StaticResource MenuPanel}">
                                        <ItemsControl ItemsSource="{Binding PageSizes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource ListOption}" Content="{Binding}"
                                                            Command="{Binding DataContext.ChoosePageSizeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Popup>
                            </Grid>

                            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="10,0,0,0" VerticalAlignment="Center"
                                          PanningMode="HorizontalOnly">
                                <StackPanel Orientation="Horizontal">
                                    <ItemsControl ItemsSource="{Binding Chips}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:FilterChip}">
                                                <Border x:Name="Bd" Background="{StaticResource SelectedFill}" BorderBrush="{StaticResource SelectedStroke}" BorderThickness="1"
                                                        CornerRadius="{StaticResource RadiusButton}"
                                                        Height="30" Padding="12,0,4,0" Margin="0,0,6,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="Text" Text="{Binding Label}" FontSize="13" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                                                        <Button Style="{StaticResource IconOnlyButton}" Width="22" Height="22" Margin="6,0,0,0" FontSize="8"
                                                                Content="{StaticResource IconClose}" Command="{Binding RemoveCommand}"
                                                                ToolTip="Quitar filtro" AutomationProperties.Name="{Binding Label, StringFormat=Quitar {0}}" />
                                                    </StackPanel>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsExcluded}" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerSoft}" />
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DangerStroke}" />
                                                        <Setter TargetName="Text" Property="Foreground" Value="#FCA5A5" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding TotalText}" FontSize="13" Foreground="{StaticResource Ink3}" VerticalAlignment="Center" Margin="4,0,0,0"
                                               Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}" />
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>

                        <!-- Lista -->
                        <Grid Margin="0,14,0,0">
                            <ScrollViewer x:Name="ResultsScroll" Template="{StaticResource GlassScrollViewer}" VerticalScrollBarVisibility="Auto"
                                          PanningMode="VerticalOnly">
                                <StackPanel Margin="0,0,4,0">
                                <ItemsControl ItemsSource="{Binding Results}">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ProjectCard}">
                                            <!-- Toda la tarjeta abre la página del proyecto; el botón Instalar va por su cuenta -->
                                            <Button Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    MouseEnter="OnCardMouseEnter" MouseLeave="OnCardMouseLeave"
                                                    CommandParameter="{Binding}" Cursor="Hand" Margin="0,0,0,12" FocusVisualStyle="{StaticResource FocusRing}"
                                                    Foreground="{StaticResource Ink}"
                                                    AutomationProperties.Name="{Binding Title}" ToolTip="{Binding Title, StringFormat=Ver la página de {0}}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Style="{StaticResource ProjectCardBorder}">
                                                            <ContentPresenter />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="16" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="14" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <Grid Width="80" Height="80" VerticalAlignment="Top">
                                                        <Border CornerRadius="14" Background="{Binding IconBackground}" BorderBrush="{StaticResource Hairline}" BorderThickness="1">
                                                            <TextBlock Text="{Binding Initial}" FontSize="30" FontWeight="SemiBold" Foreground="#E6FFFFFF"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <Border CornerRadius="14" BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                                                                Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                                        <TextBlock TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding Title, Mode=OneWay}" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold" />
                                                            <Run Text="{Binding AuthorText, Mode=OneWay}" FontSize="13.5" Foreground="{StaticResource Ink3}" />
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Description}" FontSize="13.5" Foreground="{StaticResource Ink2}" TextWrapping="Wrap"
                                                                   TextTrimming="WordEllipsis" LineHeight="20" MaxHeight="40" Margin="0,4,0,0" />
                                                        <ItemsControl ItemsSource="{Binding Tags}" ItemTemplate="{StaticResource CardTagTemplate}" Margin="0,9,0,0"
                                                                      ClipToBounds="True" Height="24">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource WideOnly}">
                                                        <Button Style="{StaticResource CardInstallButton}" MinWidth="136" Command="{Binding InstallCommand}"
                                                                AutomationProperties.Name="{Binding Title, StringFormat=Instalar {0}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock x:Name="ActionIcon" Text="{StaticResource IconAdd}" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,8,0"
                                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                                <TextBlock Text="{Binding ActionText}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                        <ProgressBar Style="{StaticResource GlassProgressBar}" Value="{Binding Progress}" Margin="6,8,6,0"
                                                                     Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibility}}" />
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,11,0,0">
                                                            <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Ink3}" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding DownloadsText}" FontSize="13" Foreground="{StaticResource Ink2}" />
                                                            <TextBlock Text="&#xEB51;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Ink3}" Margin="12,0,6,0" />
                                                            <TextBlock Text="{Binding FollowsText}" FontSize="13" Foreground="{StaticResource Ink2}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                                                            <TextBlock Text="{StaticResource IconSync}" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource Ink3}" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding UpdatedText}" FontSize="12.5" Foreground="{StaticResource Ink3}" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Modo compacto: estadísticas a la izquierda y el botón a la derecha, debajo -->
                                                    <DockPanel Grid.Row="1" Grid.ColumnSpan="5" Margin="0,12,0,0" Style="{StaticResource CompactOnly}">
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource CardInstallButton}" MinWidth="128"
                                                                Command="{Binding InstallCommand}" AutomationProperties.Name="{Binding Title, StringFormat=Instalar {0}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock x:Name="ActionIconCompact" Text="{StaticResource IconAdd}" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,8,0"
                                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                                <TextBlock Text="{Binding ActionText}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Ink3}" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding DownloadsText}" FontSize="13" Foreground="{StaticResource Ink2}" />
                                                            <TextBlock Text="&#xEB51;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Ink3}" Margin="12,0,6,0" />
                                                            <TextBlock Text="{Binding FollowsText}" FontSize="13" Foreground="{StaticResource Ink2}" />
                                                            <TextBlock Text="{StaticResource IconSync}" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource Ink3}" Margin="12,0,6,0" />
                                                            <TextBlock Text="{Binding UpdatedText}" FontSize="12.5" Foreground="{StaticResource Ink3}" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Grid>
                                            </Button>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Installed">
                                                    <Setter TargetName="ActionIcon" Property="Text" Value="{StaticResource IconCheck}" />
                                                    <Setter TargetName="ActionIconCompact" Property="Text" Value="{StaticResource IconCheck}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Installing">
                                                    <Setter TargetName="ActionIcon" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="ActionIconCompact" Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Pager}" Focusable="False"
                                                HorizontalAlignment="Center" Margin="0,2,0,10"
                                                Visibility="{Binding HasPages, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </ScrollViewer>

                            <Border Background="{StaticResource MenuGlass}" BorderBrush="{StaticResource HairlineStrong}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusButton}" Padding="18,9"
                                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" IsHitTestVisible="False"
                                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{StaticResource IconSync}" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource AccentHover}" Margin="0,0,10,0" />
                                    <TextBlock Text="Cargando…" FontSize="14" />
                                </StackPanel>
                            </Border>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="No hay resultados" Style="{StaticResource H2}" HorizontalAlignment="Center" />
                                <TextBlock Text="Prueba con otra búsqueda o quita algún filtro." Foreground="{StaticResource Ink2}" Margin="0,6,0,16"
                                           HorizontalAlignment="Center" />
                                <Button Style="{StaticResource GlassButton}" Content="Limpiar filtros" Command="{Binding ClearFiltersCommand}" HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                                        Visibility="{Binding Error, Converter={StaticResource TextToVisibility}}">
                                <TextBlock Text="No se pudo cargar" Style="{StaticResource H2}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Error}" Foreground="{StaticResource Ink2}" Margin="0,6,0,16" TextWrapping="Wrap" TextAlignment="Center" />
                                <Button Style="{StaticResource AccentButton}" Content="Reintentar" Command="{Binding RetryCommand}" HorizontalAlignment="Center" Padding="22,0" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>

                    <!-- ─── Página del proyecto ─── -->
                    <DockPanel DataContext="{Binding Project}" Visibility="{Binding DataContext.HasProject, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                        <!-- Volver a los resultados -->
                        <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Style="{StaticResource QuietButton}" Height="32" Padding="10,0" Margin="-6,0,0,8"
                                Command="{Binding DataContext.CloseProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                AutomationProperties.Name="Volver a los resultados">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72B;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Text="Resultados" VerticalAlignment="Center" FontSize="13.5" />
                            </StackPanel>
                        </Button>

                        <!-- Cabecera: icono, título, resumen, etiquetas y el botón de instalar -->
                        <Grid DockPanel.Dock="Top" DataContext="{Binding Card}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Width="88" Height="88" VerticalAlignment="Top">
                                <Border CornerRadius="16" Background="{Binding IconBackground}" BorderBrush="{StaticResource Hairline}" BorderThickness="1">
                                    <TextBlock Text="{Binding Initial}" FontSize="32" FontWeight="SemiBold" Foreground="#E6FFFFFF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border CornerRadius="16" BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                                        Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border.Background>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource ViewTitle}" FontSize="22" FontWeight="Normal" />
                                <TextBlock Text="{Binding AuthorText}" FontSize="13.5" Foreground="{StaticResource Ink3}" Margin="0,1,0,0" />
                                <TextBlock Text="{Binding Description}" FontSize="13.5" Foreground="{StaticResource Ink2}" TextWrapping="Wrap"
                                           TextTrimming="WordEllipsis" LineHeight="20" MaxHeight="40" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="4" VerticalAlignment="Top">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                <Setter Property="Grid.Row" Value="1" />
                                                <Setter Property="Grid.Column" Value="2" />
                                                <Setter Property="Grid.ColumnSpan" Value="3" />
                                                <Setter Property="HorizontalAlignment" Value="Left" />
                                                <Setter Property="Margin" Value="0,10,0,0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <!-- Mismo botón que la tarjeta (comparten estado); se ilumina al pasar sobre él -->
                                <ContentPresenter Content="{Binding}" IsHitTestVisible="True">
                                    <ContentPresenter.ContentTemplate>
                                        <DataTemplate DataType="{x:Type vm:ProjectCard}">
                                            <Button Style="{StaticResource CardInstallButton}" MinWidth="150" Height="38" Command="{Binding InstallCommand}"
                                                    AutomationProperties.Name="{Binding Title, StringFormat=Instalar {0}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="ActionIcon" Text="{StaticResource IconAdd}" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,8,0"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                    <TextBlock Text="{Binding ActionText}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Installed">
                                                    <Setter TargetName="ActionIcon" Property="Text" Value="{StaticResource IconCheck}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Installing">
                                                    <Setter TargetName="ActionIcon" Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ContentPresenter.ContentTemplate>
                                </ContentPresenter>
                                <ProgressBar Style="{StaticResource GlassProgressBar}" Value="{Binding Progress}" Margin="6,8,6,0"
                                             Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibility}}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,11,0,0">
                                    <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Ink3}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding DownloadsText}" FontSize="13" Foreground="{StaticResource Ink2}" />
                                    <TextBlock Text="&#xEB51;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Ink3}" Margin="12,0,6,0" />
                                    <TextBlock Text="{Binding FollowsText}" FontSize="13" Foreground="{StaticResource Ink2}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Etiquetas -->
                        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Card.Tags}" ItemTemplate="{StaticResource CardTagTemplate}" Margin="106,10,0,0"
                                      ClipToBounds="True" Height="24">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- Secciones: pestañas subrayadas sobre una línea fina -->
                        <Grid DockPanel.Dock="Top" Height="40" Margin="0,14,0,14">
                            <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource Hairline}" />
                            <!-- Versiones: filtrar por versión de Minecraft y por cargador -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,2"
                                        Visibility="{Binding IsVersions, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <ToggleButton x:Name="VersionFilterToggle" Style="{StaticResource GlassSelect}" IsChecked="{Binding IsVersionFilterOpen}"
                                                  AutomationProperties.Name="Filtrar por versión de Minecraft">
                                        <TextBlock>
                                            <Run Text="Minecraft:" /> <Run Text="{Binding VersionFilterLabel, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                                        </TextBlock>
                                    </ToggleButton>
                                    <Popup IsOpen="{Binding IsVersionFilterOpen}" PlacementTarget="{Binding ElementName=VersionFilterToggle}" Placement="Bottom"
                                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" MinWidth="150">
                                        <Border Style="{StaticResource MenuPanel}">
                                            <ScrollViewer Template="{StaticResource GlassScrollViewer}" MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding VersionChoices}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:FilterChoice}">
                                                            <Button Style="{StaticResource ListOption}" CommandParameter="{Binding Value}"
                                                                    Command="{Binding DataContext.ChooseVersionFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                                <TextBlock x:Name="Label" Text="{Binding Label}" />
                                                            </Button>
                                                            <DataTemplate.Triggers>
                                                                <!-- Versiones de un grupo: sangradas y más tenues bajo "1.21.x" -->
                                                                <DataTrigger Binding="{Binding IsChild}" Value="True">
                                                                    <Setter TargetName="Label" Property="Margin" Value="14,0,0,0" />
                                                                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Ink2}" />
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <Grid Margin="14,0,0,0">
                                    <ToggleButton x:Name="LoaderFilterToggle" Style="{StaticResource GlassSelect}" IsChecked="{Binding IsLoaderFilterOpen}"
                                                  AutomationProperties.Name="Filtrar por cargador">
                                        <TextBlock>
                                            <Run Text="Cargador:" /> <Run Text="{Binding LoaderFilterLabel, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                                        </TextBlock>
                                    </ToggleButton>
                                    <Popup IsOpen="{Binding IsLoaderFilterOpen}" PlacementTarget="{Binding ElementName=LoaderFilterToggle}" Placement="Bottom"
                                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" MinWidth="150">
                                        <Border Style="{StaticResource MenuPanel}">
                                            <ItemsControl ItemsSource="{Binding LoaderChoices}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:FilterChoice}">
                                                        <Button Style="{StaticResource ListOption}" Content="{Binding Label}" CommandParameter="{Binding Value}"
                                                                Command="{Binding DataContext.ChooseLoaderFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource TopTabSmall}" Height="40" GroupName="ProjectSections" Content="Descripción"
                                             IsChecked="{Binding IsDescription}" />
                                <RadioButton Style="{StaticResource TopTabSmall}" Height="40" GroupName="ProjectSections" Content="{Binding VersionsTabText}"
                                             IsChecked="{Binding IsVersions}" AutomationProperties.Name="Versiones" />
                                <RadioButton Style="{StaticResource TopTabSmall}" Height="40" GroupName="ProjectSections" Content="{Binding GalleryTabText}"
                                             IsChecked="{Binding IsGallery}" AutomationProperties.Name="Galería"
                                             Visibility="{Binding HasGallery, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <!-- Descripción -->
                            <c:HtmlView Html="{Binding DescriptionHtml}" Visibility="{Binding IsDescription, Converter={StaticResource BoolToVisibility}}" />

                            <!-- Versiones -->
                            <DockPanel Visibility="{Binding IsVersions, Converter={StaticResource BoolToVisibility}}">
                                <ScrollViewer Template="{StaticResource GlassScrollViewer}" VerticalScrollBarVisibility="Auto">
                                    <Border Style="{StaticResource GroupedList}" Margin="0,0,4,0" VerticalAlignment="Top"
                                            Visibility="{Binding Versions.Count, Converter={StaticResource ZeroToVisible}, ConverterParameter=invert}">
                                    <ItemsControl ItemsSource="{Binding Versions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:VersionRow}">
                                                <Border x:Name="Row" Style="{StaticResource GroupedItemRow}" Padding="16,10">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource InstallButton}" VerticalAlignment="Center"
                                                                Command="{Binding InstallCommand}" Content="Instalar" Margin="12,0,0,0" MinWidth="104"
                                                                AutomationProperties.Name="{Binding Number, StringFormat=Instalar la versión {0}}" />
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border x:Name="Type" CornerRadius="{StaticResource RadiusSmall}" Padding="8,1" Margin="0,0,10,0" VerticalAlignment="Center"
                                                                        Background="{StaticResource OkFill}" BorderBrush="{StaticResource OkStroke}" BorderThickness="1">
                                                                    <TextBlock x:Name="TypeText" Text="{Binding TypeLabel}" FontSize="12" Foreground="{StaticResource Ok}" />
                                                                </Border>
                                                                <TextBlock Text="{Binding Name}" FontSize="15" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <TextBlock FontSize="12.5" Foreground="{StaticResource Ink3}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis">
                                                                <Run Text="{Binding GameVersionsText, Mode=OneWay}" /> · <Run Text="{Binding LoadersText, Mode=OneWay}" /> · <Run Text="{Binding DateText, Mode=OneWay}" /> · <Run Text="{Binding DownloadsText, Mode=OneWay}" /> descargas
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding TypeKind}" Value="beta">
                                                        <Setter TargetName="Type" Property="Background" Value="#1FF5B041" />
                                                        <Setter TargetName="Type" Property="BorderBrush" Value="#59F5B041" />
                                                        <Setter TargetName="TypeText" Property="Foreground" Value="{StaticResource Warn}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TypeKind}" Value="alpha">
                                                        <Setter TargetName="Type" Property="Background" Value="{StaticResource DangerSoft}" />
                                                        <Setter TargetName="Type" Property="BorderBrush" Value="{StaticResource DangerStroke}" />
                                                        <Setter TargetName="TypeText" Property="Foreground" Value="#FCA5A5" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </Border>
                                </ScrollViewer>
                            </DockPanel>
                            <TextBlock Text="{Binding VersionsEmptyText}" Foreground="{StaticResource Ink2}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsVersions}" Value="True" />
                                                    <Condition Binding="{Binding Versions.Count}" Value="0" />
                                                    <Condition Binding="{Binding IsVersionsLoading}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Galería: un clic abre la imagen a tamaño completo en el navegador -->
                            <ScrollViewer Template="{StaticResource GlassScrollViewer}" VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding IsGallery, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl ItemsSource="{Binding Gallery}" ItemsPanel="{StaticResource WrapItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:GalleryItem}">
                                            <Button Width="296" Margin="0,0,10,12" Cursor="Hand" FocusVisualStyle="{StaticResource FocusRing}"
                                                    Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Image.Url}" ToolTip="Abrir la imagen" AutomationProperties.Name="{Binding Title}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <StackPanel>
                                                            <Border x:Name="Frame" Height="166" CornerRadius="{StaticResource RadiusGroup}" BorderBrush="{StaticResource InnerStroke}" BorderThickness="1"
                                                                    Background="{StaticResource InnerFill}">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{StaticResource Ink2}" Margin="2,6,0,0"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Visibility="{Binding HasTitle, Converter={StaticResource BoolToVisibility}}" />
                                                        </StackPanel>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Border CornerRadius="11">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding Source}" Stretch="UniformToFill" />
                                                    </Border.Background>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Cargando / error -->
                            <TextBlock Text="Cargando…" FontSize="14" Foreground="{StaticResource Ink2}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,30,0,0"
                                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding Error}" FontSize="14" Foreground="#FCA5A5" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Top"
                                       Margin="0,30,0,0" Visibility="{Binding Error, Converter={StaticResource TextToVisibility}}" />
                        </Grid>
                    </DockPanel>
                </Grid>
            </DockPanel>

            <!-- ═══ Columna derecha: destino y filtros (o la información del proyecto) ═══ -->
            <Border Grid.Column="2" Style="{StaticResource GroupedList}">
                <DockPanel>
                    <!-- Limpiar filtros (solo con la lista) -->
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource PillGhostButton}" Margin="16,6,16,14" Content="Limpiar filtros"
                            Command="{Binding ClearFiltersCommand}" AutomationProperties.Name="Limpiar filtros"
                            Visibility="{Binding HasProject, Converter={StaticResource InverseBoolToVisibility}}" />

                    <Grid>
                        <!-- Filtros: versión del juego, cargador y categoría primero -->
                        <ScrollViewer Template="{StaticResource GlassScrollViewer}" VerticalScrollBarVisibility="Auto" Margin="16,8,6,0"
                                      Visibility="{Binding HasProject, Converter={StaticResource InverseBoolToVisibility}}">
                            <StackPanel Margin="0,0,8,0">
                                <!-- Versión del juego: dos columnas alineadas -->
                                <ToggleButton Style="{StaticResource GroupHeader}" IsChecked="{Binding IsVersionExpanded}" AutomationProperties.Name="Versión del juego">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Versión del juego" Style="{StaticResource GroupTitle}" />
                                        <TextBlock Text="{Binding VersionActiveText}" Style="{StaticResource GroupActive}" />
                                    </StackPanel>
                                </ToggleButton>
                                <StackPanel Visibility="{Binding IsVersionExpanded, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
                                    <ScrollViewer Template="{StaticResource GlassScrollViewer}" MaxHeight="176" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding GameVersions}" ItemTemplate="{StaticResource FilterPillTemplate}"
                                                      ItemsPanel="{StaticResource TwoColumns}" />
                                    </ScrollViewer>
                                    <CheckBox Style="{StaticResource SwitchCheckBox}" IsChecked="{Binding ShowSnapshots}" Margin="0,8,0,0" FontSize="13.5"
                                              Content="Mostrar snapshots" Foreground="{StaticResource Ink2}" />
                                </StackPanel>

                                <!-- Cargador: los principales y, al desplegar, el resto -->
                                <StackPanel Visibility="{Binding ShowLoaders, Converter={StaticResource BoolToVisibility}}">
                                    <Border Height="1" Background="{StaticResource InnerStroke}" />
                                    <ToggleButton Style="{StaticResource GroupHeader}" IsChecked="{Binding IsLoaderExpanded}" AutomationProperties.Name="Cargador">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Cargador" Style="{StaticResource GroupTitle}" />
                                            <TextBlock Text="{Binding LoaderActiveText}" Style="{StaticResource GroupActive}" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <StackPanel Margin="0,0,0,8" Visibility="{Binding IsLoaderExpanded, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl ItemsSource="{Binding MainLoaders}" ItemTemplate="{StaticResource FilterPillTemplate}"
                                                      ItemsPanel="{StaticResource TwoColumns}" />
                                        <ItemsControl ItemsSource="{Binding OtherLoaders}" ItemTemplate="{StaticResource FilterPillTemplate}"
                                                      ItemsPanel="{StaticResource TwoColumns}"
                                                      Visibility="{Binding ShowOtherLoaders, Converter={StaticResource BoolToVisibility}}" />
                                        <ToggleButton Style="{StaticResource MoreToggle}" IsChecked="{Binding ShowOtherLoaders}"
                                                      AutomationProperties.Name="Más cargadores"
                                                      Visibility="{Binding HasOtherLoaders, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Categoría -->
                                <Border Height="1" Background="{StaticResource InnerStroke}" />
                                <ToggleButton Style="{StaticResource GroupHeader}" IsChecked="{Binding IsCategoryExpanded}" AutomationProperties.Name="Categoría">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Categoría" Style="{StaticResource GroupTitle}" />
                                        <TextBlock Text="{Binding CategoryActiveText}" Style="{StaticResource GroupActive}" />
                                    </StackPanel>
                                </ToggleButton>
                                <StackPanel Visibility="{Binding IsCategoryExpanded, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
                                    <ItemsControl ItemsSource="{Binding Categories}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:CategoryFilter}">
                                                <Button Command="{Binding CycleCommand}" Cursor="Hand" FocusVisualStyle="{StaticResource FocusRingRow}" AutomationProperties.Name="{Binding Label}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Row" Background="Transparent" CornerRadius="{StaticResource RadiusRow}" Padding="8,6" Margin="0,0,0,2">
                                                                <DockPanel>
                                                                    <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" BorderThickness="1"
                                                                            BorderBrush="#4DFFFFFF" Background="Transparent" Margin="0,0,10,0">
                                                                        <TextBlock x:Name="Mark" Style="{StaticResource Icon}" FontSize="9" HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center" Foreground="White" />
                                                                    </Border>
                                                                    <TextBlock x:Name="Label" Text="{Binding Label}" FontSize="14" Foreground="{StaticResource Ink2}"
                                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                </DockPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource RowHover}" />
                                                                </Trigger>
                                                                <DataTrigger Binding="{Binding State}" Value="Included">
                                                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource SelectedFill}" />
                                                                    <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}" />
                                                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                                    <Setter TargetName="Mark" Property="Text" Value="{StaticResource IconCheck}" />
                                                                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Ink}" />
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Contenido incluido -->
                                <StackPanel Visibility="{Binding ShowFeatures, Converter={StaticResource BoolToVisibility}}">
                                    <Border Height="1" Background="{StaticResource InnerStroke}" />
                                    <ToggleButton Style="{StaticResource GroupHeader}" IsChecked="{Binding IsFeatureExpanded}" AutomationProperties.Name="Contenido incluido">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Contenido incluido" Style="{StaticResource GroupTitle}" />
                                            <TextBlock Text="{Binding FeatureActiveText}" Style="{StaticResource GroupActive}" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <StackPanel Visibility="{Binding IsFeatureExpanded, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
                                        <TextBox Style="{StaticResource GlassTextBox}" Height="34" FontSize="13" Tag="Buscar…" Margin="0,0,0,10"
                                                 Text="{Binding FeatureFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Buscar contenido incluido" />
                                        <ItemsControl ItemsSource="{Binding VisibleFeatures}" ItemTemplate="{StaticResource FilterPillTemplate}"
                                                      ItemsPanel="{StaticResource WrapItems}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Entorno -->
                                <StackPanel Visibility="{Binding ShowEnvironment, Converter={StaticResource BoolToVisibility}}">
                                    <Border Height="1" Background="{StaticResource InnerStroke}" />
                                    <ToggleButton Style="{StaticResource GroupHeader}" IsChecked="{Binding IsEnvironmentExpanded}" AutomationProperties.Name="Entorno">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Entorno" Style="{StaticResource GroupTitle}" />
                                            <TextBlock Text="{Binding EnvironmentActiveText}" Style="{StaticResource GroupActive}" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <ItemsControl ItemsSource="{Binding Environments}" ItemTemplate="{StaticResource FilterPillTemplate}"
                                                  ItemsPanel="{StaticResource WrapItems}" Margin="0,0,0,8"
                                                  Visibility="{Binding IsEnvironmentExpanded, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>

                                <!-- Licencia (plegado) -->
                                <Border Height="1" Background="{StaticResource InnerStroke}" />
                                <ToggleButton Style="{StaticResource GroupHeader}" IsChecked="{Binding IsLicenseExpanded}" AutomationProperties.Name="Licencia">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Licencia" Style="{StaticResource GroupTitle}" />
                                        <TextBlock Text="{Binding LicenseActiveText}" Style="{StaticResource GroupActive}" />
                                    </StackPanel>
                                </ToggleButton>
                                <CheckBox Style="{StaticResource SwitchCheckBox}" IsChecked="{Binding OpenSourceOnly}" Margin="0,0,0,10" FontSize="13.5"
                                          Content="Solo código abierto" Foreground="{StaticResource Ink2}"
                                          Visibility="{Binding IsLicenseExpanded, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Información del proyecto -->
                        <ScrollViewer Template="{StaticResource GlassScrollViewer}" VerticalScrollBarVisibility="Auto" Margin="16,10,6,12"
                                      DataContext="{Binding Project}"
                                      Visibility="{Binding DataContext.HasProject, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Margin="0,4,8,0">
                                <TextBlock Text="Compatibilidad" Style="{StaticResource GroupTitle}" Margin="0,8,0,10" />
                                <TextBlock Text="Minecraft" FontSize="12.5" Foreground="{StaticResource Ink3}" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding GameVersionGroups}" ItemsPanel="{StaticResource WrapItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:CompatChip}">
                                            <Button Style="{StaticResource CompatChipButton}" CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.ShowGameVersionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    ToolTip="Ver los archivos para esta versión" AutomationProperties.Name="{Binding Value, StringFormat=Archivos para Minecraft {0}}">
                                                <Border Background="{StaticResource InnerFill}" BorderBrush="{StaticResource InnerStroke}" BorderThickness="1"
                                                        CornerRadius="{StaticResource RadiusSmall}" Padding="9,2">
                                                    <TextBlock Text="{Binding Tag.Text}" FontSize="12.5" Foreground="{StaticResource Ink2}" />
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Plataformas" FontSize="12.5" Foreground="{StaticResource Ink3}" Margin="0,8,0,6" />
                                <ItemsControl ItemsSource="{Binding Loaders}" ItemsPanel="{StaticResource WrapItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:CompatChip}">
                                            <Button Style="{StaticResource CompatChipButton}" CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.ShowLoaderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    ToolTip="Ver los archivos para este cargador" AutomationProperties.Name="{Binding Tag.Text, StringFormat=Archivos para {0}}">
                                                <ContentPresenter Content="{Binding Tag}" ContentTemplate="{StaticResource CardTagTemplate}" Margin="0,0,-6,0" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Entorno" FontSize="12.5" Foreground="{StaticResource Ink3}" Margin="0,12,0,4" />
                                <TextBlock Text="{Binding EnvironmentText}" FontSize="13.5" />

                                <StackPanel Visibility="{Binding HasLinks, Converter={StaticResource BoolToVisibility}}">
                                    <Border Height="1" Background="{StaticResource InnerStroke}" Margin="0,16,0,6" />
                                    <TextBlock Text="Enlaces" Style="{StaticResource GroupTitle}" Margin="0,8,0,6" />
                                    <ItemsControl ItemsSource="{Binding Links}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ProjectLink}">
                                                <Button Style="{StaticResource ListOption}" Margin="-12,0,0,0"
                                                        Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Url}" ToolTip="{Binding Url}" AutomationProperties.Name="{Binding Label}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource AccentHover}" Margin="0,0,10,0" />
                                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <Border Height="1" Background="{StaticResource InnerStroke}" Margin="0,14,0,6" />
                                <TextBlock Text="Detalles" Style="{StaticResource GroupTitle}" Margin="0,8,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <Grid.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="13" />
                                            <Setter Property="Margin" Value="0,0,0,7" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        </Style>
                                    </Grid.Resources>
                                    <TextBlock Grid.Row="0" Text="Licencia" Foreground="{StaticResource Ink3}" Margin="0,0,14,7" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LicenseText}" />
                                    <TextBlock Grid.Row="1" Text="Publicado" Foreground="{StaticResource Ink3}" Margin="0,0,14,7" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PublishedText}" />
                                    <TextBlock Grid.Row="2" Text="Actualizado" Foreground="{StaticResource Ink3}" Margin="0,0,14,7" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding UpdatedText}" />
                                    <TextBlock Grid.Row="3" Text="Descargas" Foreground="{StaticResource Ink3}" Margin="0,0,14,7" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DownloadsText}" />
                                    <TextBlock Grid.Row="4" Text="Seguidores" Foreground="{StaticResource Ink3}" Margin="0,0,14,7" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding FollowersText}" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ═══ Elegir mundo para un data pack ═══ -->
        <Grid Grid.RowSpan="2" Background="{StaticResource ModalScrim}" Visibility="{Binding IsWorldPickerOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Width="380" VerticalAlignment="Center" Background="{StaticResource MenuGlass}" BorderBrush="{StaticResource HairlineStrong}" BorderThickness="1"
                    CornerRadius="16" Padding="22,20" Effect="{StaticResource PanelShadow}">
                <StackPanel>
                    <TextBlock Text="{Binding WorldPickerTitle}" Style="{StaticResource H2}" FontSize="18" TextWrapping="Wrap" />
                    <TextBlock Text="Los data packs se instalan en un mundo." Style="{StaticResource Hint}" Margin="0,4,0,14" />
                    <ScrollViewer Template="{StaticResource GlassScrollViewer}" MaxHeight="260" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Worlds}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ListOption}" Height="40" Content="{Binding}"
                                            Command="{Binding DataContext.ChooseWorldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Style="{StaticResource QuietButton}" Content="Cancelar" HorizontalAlignment="Right" Margin="0,14,0,0"
                            Command="{Binding CancelWorldPickerCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
