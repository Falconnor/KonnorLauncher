<Window x:Class="KonnorLauncher.App.Views.SkinPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vista previa de Skin"
        Icon="pack://application:,,,/Assets/icon.ico"
        Width="360" Height="460" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource SkinWindowBg}"
        FontFamily="{DynamicResource MainFont}"
        SizeToContent="Manual">
    <!-- Ventana normal con marco del sistema: márgenes 16, espaciado 12 -->
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="VISTA PREVIA DE SKIN" FontSize="{StaticResource Pt12}" FontWeight="Bold"
                   Foreground="{StaticResource White}" HorizontalAlignment="Center" Margin="0,0,0,12" />

        <!-- Pie: nombre del archivo (Arial 8 pt, blanco α100) -->
        <TextBlock x:Name="FileNameText" DockPanel.Dock="Bottom" FontFamily="Arial" FontSize="{StaticResource Pt8}"
                   Foreground="{StaticResource WhiteA100}" HorizontalAlignment="Center" />

        <!-- Error si la imagen no carga -->
        <TextBlock x:Name="ErrorText" DockPanel.Dock="Top" Text="No se pudo cargar la imagen" Foreground="{StaticResource ErrorBrush}"
                   HorizontalAlignment="Center" Visibility="Collapsed" />

        <!-- Dos columnas (espaciado 24): FRENTE y ESPALDA, imágenes 128×256 sobre negro α40 -->
        <StackPanel x:Name="ViewsPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
            <StackPanel Margin="0,0,24,0">
                <TextBlock Text="FRENTE" FontSize="{StaticResource Pt9}" FontWeight="Bold" Foreground="{StaticResource WhiteA150}"
                           HorizontalAlignment="Center" Margin="0,0,0,4" />
                <Border Background="#28000000" CornerRadius="8" Padding="8">
                    <Image x:Name="FrontImage" Width="128" Height="256" Stretch="Fill"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Border>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="ESPALDA" FontSize="{StaticResource Pt9}" FontWeight="Bold" Foreground="{StaticResource WhiteA150}"
                           HorizontalAlignment="Center" Margin="0,0,0,4" />
                <Border Background="#28000000" CornerRadius="8" Padding="8">
                    <Image x:Name="BackImage" Width="128" Height="256" Stretch="Fill"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Border>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
