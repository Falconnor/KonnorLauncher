<UserControl x:Class="KonnorLauncher.App.Views.InstallDialogOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:KonnorLauncher.App.ViewModels"
             xmlns:c="clr-namespace:KonnorLauncher.App.Controls"
             xmlns:conv="clr-namespace:KonnorLauncher.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:InstallDialogViewModel}"
             IsVisibleChanged="OnIsVisibleChanged">
    <UserControl.Resources>
        <conv:TextToVisibilityConverter x:Key="TextToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:InverseBoolConverter x:Key="InverseBool" />

        <!-- Pastilla seleccionable (versión de Minecraft, cargador) -->
        <Style x:Key="OptionPill" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink2}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource Surface}" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="16" Padding="13,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}" />
                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource ModalScrim}">
        <c:GlassPanel Width="620" Height="600" Padding="0" Background="{StaticResource GlassTintStrong}" BlurRadius="40">
            <DockPanel KeyboardNavigation.TabNavigation="Cycle">
                <!-- Cabecera -->
                <DockPanel DockPanel.Dock="Top" Margin="28,22,20,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconOnlyButton}" Content="{StaticResource IconClose}"
                            FontSize="11" Command="{Binding CancelCommand}" AutomationProperties.Name="Cerrar" />
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" FontSize="21" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>

                <!-- ¿En una existente o en una nueva? -->
                <UniformGrid DockPanel.Dock="Top" Columns="2" Margin="28,12,28,14">
                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="InstallMode" Content="Instancia existente" Margin="0,0,4,0"
                                 AutomationProperties.Name="Instalar en una instancia existente"
                                 IsChecked="{Binding IsExistingMode}" />
                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="InstallMode" Content="Nueva instancia" Margin="4,0,0,0"
                                 AutomationProperties.Name="Crear una instancia nueva"
                                 IsChecked="{Binding IsNewMode}" IsEnabled="{Binding CanCreate}" />
                </UniformGrid>

                <!-- Pie -->
                <DockPanel DockPanel.Dock="Bottom" Margin="28,10,28,22">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource QuietButton}" Content="Cancelar" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource AccentButton}" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" Padding="22,0"
                                AutomationProperties.Name="Confirmar instalación" />
                    </StackPanel>
                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center"
                               Margin="0,0,12,0" Visibility="{Binding Error, Converter={StaticResource TextToVisibility}}" />
                </DockPanel>

                <Grid Margin="28,0,14,0">
                    <TextBlock Text="Buscando versiones compatibles…" Foreground="{StaticResource Ink2}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

                    <!-- ── Instancia existente ── -->
                    <DockPanel Margin="0,0,14,0">
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsLoading}" Value="False" />
                                            <Condition Binding="{Binding IsNewMode}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Text="Solo aparecen las instancias compatibles. Las vinculadas a un servidor no: su contenido lo decide el servidor." />
                        <Grid>
                            <TextBlock Text="{Binding NoInstancesText}" Foreground="{StaticResource Ink2}" TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                                       Visibility="{Binding HasInstances, Converter={StaticResource InverseBoolToVisibility}}" />
                            <ScrollViewer Template="{StaticResource GlassScrollViewer}" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Instances}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:InstanceChoice}">
                                            <Button Command="{Binding DataContext.SelectInstanceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,0,4,6"
                                                    Foreground="{StaticResource Ink}" AutomationProperties.Name="{Binding Name}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="{StaticResource Surface}" BorderBrush="Transparent" BorderThickness="1"
                                                                CornerRadius="12" Padding="10,8">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                            </DataTrigger>
                                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentHover}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="10" Background="{StaticResource Surface}"
                                                            BorderBrush="#14FFFFFF" BorderThickness="1" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Initials}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <Border DockPanel.Dock="Right" CornerRadius="10" Padding="9,2" VerticalAlignment="Center"
                                                            Background="#1F27AE60" BorderBrush="#5927AE60" BorderThickness="1"
                                                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="Ya instalado" FontSize="12" Foreground="{StaticResource Ok}" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Summary}" FontSize="12.5" Foreground="{StaticResource Ink3}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>

                    <!-- ── Nueva instancia: solo versiones y cargadores con versión del proyecto ── -->
                    <ScrollViewer Template="{StaticResource GlassScrollViewer}" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsLoading}" Value="False" />
                                            <Condition Binding="{Binding IsNewMode}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel Margin="0,0,14,8">
                            <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource GlassTextBox}" MaxLength="40" Tag="Nombre de la instancia"
                                     Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nombre de la instancia" />

                            <TextBlock Text="Versión de Minecraft" Style="{StaticResource FieldLabel}" Margin="0,18,0,8" />
                            <ScrollViewer Template="{StaticResource GlassScrollViewer}" MaxHeight="118" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding MinecraftVersions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource OptionPill}" Content="{Binding Label}" AutomationProperties.Name="{Binding Label, StringFormat=Minecraft {0}}"
                                                    Command="{Binding DataContext.ChooseVersionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="Solo las versiones para las que hay versión de este proyecto." Style="{StaticResource Hint}" Margin="0,2,0,0" />

                            <StackPanel Visibility="{Binding ShowLoaders, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Cargador de mods" Style="{StaticResource FieldLabel}" Margin="0,18,0,8" />
                                <ItemsControl ItemsSource="{Binding Loaders}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource OptionPill}" Content="{Binding Label}" AutomationProperties.Name="{Binding Label, StringFormat=Cargador {0}}"
                                                    Command="{Binding DataContext.ChooseLoaderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Versión del cargador" Style="{StaticResource FieldLabel}" Margin="0,12,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="LoaderChannel" Content="Estable" Margin="0,0,6,0"
                                                 IsChecked="{Binding UseLatestLoader, Converter={StaticResource InverseBool}}" />
                                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="LoaderChannel" Content="Última"
                                                 IsChecked="{Binding UseLatestLoader}" />
                                </StackPanel>
                                <TextBlock Text="{Binding LoaderStatus}" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </c:GlassPanel>
    </Grid>
</UserControl>
