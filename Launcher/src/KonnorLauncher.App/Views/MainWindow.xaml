<Window x:Class="KonnorLauncher.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:KonnorLauncher.App.ViewModels"
        xmlns:views="clr-namespace:KonnorLauncher.App.Views"
        xmlns:c="clr-namespace:KonnorLauncher.App.Controls"
        xmlns:conv="clr-namespace:KonnorLauncher.App.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Konnor Launcher"
        Icon="pack://application:,,,/Assets/icon.ico"
        Width="1280" Height="800" MinWidth="1024" MinHeight="768"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#0B0E13"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource Ink}"
        TextOptions.TextFormattingMode="Ideal"
        MouseLeftButtonDown="OnWindowMouseLeftButtonDown"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewTextInput="OnPreviewTextInput"
        StateChanged="OnStateChanged">

    <!-- Sin marco, pero con bordes para cambiar el tamaño (el arrastre lo hace la propia ventana) -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:ZeroToVisibleConverter x:Key="ZeroToVisible" />
        <conv:TextToVisibilityConverter x:Key="TextToVisibility" />

        <!-- La ventana de cristal deja 10 px alrededor (se ven la sombra y el fondo). Maximizada,
             ocupa todo, sin margen ni esquinas. -->
        <Style x:Key="WindowGlass" TargetType="c:GlassPanel" BasedOn="{StaticResource {x:Type c:GlassPanel}}">
            <Setter Property="Margin" Value="10" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="BlurRadius" Value="70" />
            <Setter Property="Background" Value="{StaticResource WindowTint}" />
            <Setter Property="BorderBrush" Value="{StaticResource WindowStroke}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="CornerRadius" Value="0" />
                    <Setter Property="BorderThickness" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WindowShadowFrame" TargetType="Border">
            <Setter Property="Margin" Value="10" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="{StaticResource WindowShadowFill}" />
            <Setter Property="Effect" Value="{StaticResource WindowShadow}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Búsqueda de la cabecera: lleva a Explorar con el foco en su caja de búsqueda -->
        <Style x:Key="HeaderSearch" TargetType="Button">
            <Setter Property="Width" Value="320" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="IBeam" />
            <Setter Property="Foreground" Value="{StaticResource Ink3}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingRow}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource FieldQuiet}" CornerRadius="8" Padding="12,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource FieldQuietHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Avatar del jugador en la cabecera (abre la cuenta) -->
        <Style x:Key="HeaderAvatar" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingPill}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <ContentPresenter />
                            <Ellipse x:Name="Ring" Stroke="{StaticResource AvatarRing}" StrokeThickness="2" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource AvatarRingHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Todo lo que se ve detrás de los overlays (ellos lo desenfocan entero) -->
        <Grid x:Name="MainContent">
            <!-- ── Fondo: imagen + aurora de color. Es lo que se ve desenfocado a través del cristal ── -->
            <Grid x:Name="Backdrop" ClipToBounds="True">
                <Border Background="{StaticResource FallbackBackground}" />
                <Image Source="pack://application:,,,/Assets/background.png" Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <!-- Aurora: manchas grandes de color saturado en las esquinas. Atraviesan el cristal y
                     le dan su color; sin animación. -->
                <Grid IsHitTestVisible="False">
                    <Ellipse Width="860" Height="860" Fill="{StaticResource AuroraBlue}" Opacity="0.55"
                             HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-300,-340,0,0" />
                    <Ellipse Width="760" Height="760" Fill="{StaticResource AuroraViolet}" Opacity="0.5"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-280,-200,0" />
                    <Ellipse Width="900" Height="900" Fill="{StaticResource AuroraRed}" Opacity="0.45"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-320,-380" />
                    <Ellipse Width="680" Height="680" Fill="{StaticResource AuroraCyan}" Opacity="0.5"
                             HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-260,0,0,-300" />
                </Grid>
                <Border Background="{StaticResource Scrim}" />
            </Grid>

            <!-- ── Ventana de cristal: un único panel desenfocado; dentro, solo capas semitransparentes ── -->
            <Border Style="{StaticResource WindowShadowFrame}" />
            <c:GlassPanel Style="{StaticResource WindowGlass}" c:GlassPanel.Backdrop="{Binding ElementName=Backdrop}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="62" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Capas: barra lateral más oscura, cabecera un poco más clara y las líneas que las separan -->
                    <Border Grid.Column="0" Grid.RowSpan="2" Background="{StaticResource SidebarShade}" />
                    <Border Grid.Column="1" Grid.Row="0" Background="{StaticResource HeaderTint}" />
                    <Border Grid.Column="0" Grid.RowSpan="2" Width="1" HorizontalAlignment="Right" Background="{StaticResource Hairline}" />
                    <Border Grid.Column="1" Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{StaticResource Hairline}" />

                    <!-- ═══ Cabecera (primera en el orden de tabulación) ═══ -->
                    <Grid Grid.Column="1" Grid.Row="0" Margin="24,0,18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Pestañas principales -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <RadioButton Style="{StaticResource TopTab}" GroupName="MainTabs" Content="Instancias"
                                         IsChecked="{Binding IsInstancesTab}" Tag="{Binding HasUpdates}"
                                         AutomationProperties.Name="Instancias" />
                            <RadioButton Style="{StaticResource TopTab}" GroupName="MainTabs" Content="Explorar"
                                         IsChecked="{Binding IsBrowseTab}"
                                         AutomationProperties.Name="Explorar" />
                        </StackPanel>

                        <!-- Búsqueda -->
                        <Button Grid.Column="2" Style="{StaticResource HeaderSearch}" Click="OnHeaderSearchClick"
                                ToolTip="Buscar en Modrinth (tecla /)" AutomationProperties.Name="Buscar contenido">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconSearch}" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,10,0" />
                                <TextBlock Text="Buscar mods, modpacks, shaders…" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>

                        <!-- Campana: instancias con una actualización del servidor -->
                        <Grid Grid.Column="3" Margin="14,0,0,0" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconOnlyButton}" Content="{StaticResource IconBell}" FontSize="16"
                                    Background="Transparent" Command="{Binding ShowUpdatesCommand}"
                                    ToolTip="Actualizaciones de las instancias" AutomationProperties.Name="Actualizaciones" />
                            <Border Style="{StaticResource BadgeSmall}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,-2,-4,0" IsHitTestVisible="False"
                                    Visibility="{Binding HasUpdates, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding UpdateCount}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <!-- Avatar del jugador -->
                        <Button Grid.Column="4" Style="{StaticResource HeaderAvatar}" Margin="12,0,0,0" Command="{Binding OpenAccountCommand}"
                                ToolTip="{Binding PlayerName}" AutomationProperties.Name="Abrir cuenta">
                            <Grid>
                                <Ellipse Fill="{StaticResource AccentSoft}"
                                         Visibility="{Binding HasPlayerAvatar, Converter={StaticResource InverseBoolToVisibility}}" />
                                <TextBlock Text="{Binding PlayerInitials}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding HasPlayerAvatar, Converter={StaticResource InverseBoolToVisibility}}" />
                                <Ellipse Visibility="{Binding HasPlayerAvatar, Converter={StaticResource BoolToVisibility}}">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding PlayerAvatar}" Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                        </Button>
                    </Grid>

                    <!-- Semáforos: cerrar, minimizar y maximizar (encima de la barra lateral) -->
                    <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center"
                                HorizontalAlignment="Left" Background="Transparent">
                        <Button Style="{StaticResource TrafficLightButton}" Background="{StaticResource LightClose}"
                                Content="{StaticResource IconClose}" Click="OnCloseClick" ToolTip="Cerrar" AutomationProperties.Name="Cerrar" />
                        <Button Style="{StaticResource TrafficLightButton}" Background="{StaticResource LightMinimize}"
                                Content="{StaticResource IconMinimize}" Click="OnMinimizeClick" ToolTip="Minimizar" AutomationProperties.Name="Minimizar" />
                        <Button x:Name="MaximizeButton" Style="{StaticResource TrafficLightButton}" Background="{StaticResource LightMaximize}"
                                Content="{StaticResource IconMaximize}" Click="OnMaximizeClick" ToolTip="Maximizar" AutomationProperties.Name="Maximizar" />
                    </StackPanel>

                    <!-- ═══ Barra lateral: Explorar, instancias, jugador y Opciones ═══
                         (1 px a la derecha libre: ahí va la línea que la separa del contenido) -->
                    <Grid Grid.Column="0" Grid.Row="1" Margin="0,0,1,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- Marca -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="24,0,14,24">
                            <Image Source="pack://application:,,,/Assets/icon.png" Width="24" Height="24"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="Konnor Launcher" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding LauncherVersionText}" FontSize="12" Foreground="{StaticResource Ink3}"
                                       Margin="8,1,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Grupo Explorar: abre la página en esa pestaña -->
                        <StackPanel Grid.Row="1" Margin="14,0,14,28">
                            <TextBlock Text="Explorar" Style="{StaticResource SidebarGroupLabel}" />
                            <ItemsControl ItemsSource="{Binding SidebarBrowseTabs}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:BrowseTab}">
                                        <Button Command="{Binding DataContext.OpenBrowseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" AutomationProperties.Name="{Binding Label, StringFormat=Explorar {0}}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SidebarAction}">
                                                    <Style.Triggers>
                                                        <!-- Marcado: es la pestaña que se está viendo en Explorar -->
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsActive}" Value="True" />
                                                                <Condition Binding="{Binding DataContext.IsBrowsing, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Background" Value="{StaticResource RowSelected}" />
                                                            <Setter Property="Foreground" Value="{StaticResource Ink}" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" Width="18" Margin="0,0,12,0" />
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Grupo Instancias: etiqueta, contador de actualizaciones y nueva instancia -->
                        <DockPanel Grid.Row="2" Margin="14,0,14,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconOnlyButton}" Width="28" Height="28" FontSize="12"
                                    Content="{StaticResource IconAdd}" Command="{Binding NewInstanceCommand}"
                                    ToolTip="Nueva instancia" AutomationProperties.Name="Nueva instancia" />
                            <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Margin="0,0,8,0"
                                    ToolTip="Instancias con una actualización del servidor"
                                    Visibility="{Binding HasUpdates, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding UpdateCount}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Instancias" Style="{StaticResource SidebarGroupLabel}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </DockPanel>

                        <!-- Lista de instancias (estilo lista de chats) -->
                        <Grid Grid.Row="3">
                            <ListBox ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     ItemContainerStyle="{StaticResource InstanceListItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     AutomationProperties.Name="Instancias">
                                <ListBox.Template>
                                    <ControlTemplate TargetType="ListBox">
                                        <ScrollViewer Template="{StaticResource GlassScrollViewer}" Focusable="False">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ListBox.Template>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:InstanceItemViewModel}">
                                        <DockPanel>
                                            <!-- Icono redondo con el color del cargador y el punto de estado -->
                                            <Grid DockPanel.Dock="Left" Width="44" Height="44" Margin="0,0,12,0">
                                                <Border CornerRadius="22" Background="{StaticResource TileBackground}" BorderThickness="1.5"
                                                        BorderBrush="{Binding Loader, Converter={StaticResource LoaderBrush}}">
                                                    <TextBlock Text="{Binding Initials}" FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{Binding Loader, Converter={StaticResource LoaderBrush}}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <!-- Verde: sincronizada con su servidor; ámbar: con una actualización; sin punto: normal -->
                                                <Ellipse Visibility="{Binding IsSynced, Converter={StaticResource BoolToVisibility}}">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse" BasedOn="{StaticResource PresenceDot}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                                                    <Setter Property="Fill" Value="{StaticResource Warn}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                            </Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="15" TextTrimming="CharacterEllipsis" />
                                                <!-- Una sola línea: el resumen o, si hay, el aviso de actualización -->
                                                <TextBlock FontSize="13" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding Summary}" />
                                                            <Setter Property="Foreground" Value="{StaticResource Ink3}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                                                    <Setter Property="Text" Value="Actualización disponible" />
                                                                    <Setter Property="Foreground" Value="{StaticResource Warn}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="Todavía no hay instancias." Style="{StaticResource Hint}" Margin="24,8,14,0"
                                       Visibility="{Binding HasInstances, Converter={StaticResource InverseBoolToVisibility}}" />
                        </Grid>
                        <!-- Pie: jugador y Opciones, separados de la lista por una línea a todo el ancho -->
                        <Border Grid.Row="4" BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Padding="14,10,14,14">
                            <StackPanel>
                                <!-- Jugador: al pulsarlo se abre la cuenta (nombre, foto de perfil y skin) -->
                                <Button Command="{Binding OpenAccountCommand}" Cursor="Hand" FocusVisualStyle="{StaticResource FocusRingRow}"
                                        ToolTip="Cuenta: nombre, foto de perfil y skin" AutomationProperties.Name="Cuenta sin conexión">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource RadiusRow}" Padding="10,8">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHover}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="&#xE76C;" FontSize="11" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                    <Setter Property="Foreground" Value="{StaticResource Ink3}" />
                                                    <Setter Property="Opacity" Value="0.6" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                            <Setter Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Grid Width="36" Height="36">
                                            <Ellipse Fill="{StaticResource AccentSoft}"
                                                     Visibility="{Binding HasPlayerAvatar, Converter={StaticResource InverseBoolToVisibility}}" />
                                            <TextBlock Text="{Binding PlayerInitials}" FontSize="12" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding HasPlayerAvatar, Converter={StaticResource InverseBoolToVisibility}}" />
                                            <Ellipse Visibility="{Binding HasPlayerAvatar, Converter={StaticResource BoolToVisibility}}">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding PlayerAvatar}" Stretch="UniformToFill" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <Ellipse Stroke="{StaticResource AvatarRing}" StrokeThickness="2" />
                                        </Grid>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PlayerName}" FontSize="15" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Ink}" />
                                            <TextBlock Text="Jugador sin conexión" FontSize="12.5" Foreground="{StaticResource Ink3}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                                <Button Style="{StaticResource SidebarAction}" Margin="0,4,0,0" Command="{Binding OpenOptionsCommand}"
                                        AutomationProperties.Name="Opciones">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{StaticResource IconSettings}" Style="{StaticResource Icon}" Width="18" Margin="0,0,12,0" />
                                        <TextBlock Text="Opciones" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                    </Grid>

                    <!-- ═══ Contenido ═══ -->
                    <Grid Grid.Column="1" Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Instancia seleccionada: cabecera, cifras, carpeta y mods (la lista ocupa lo que queda) -->
                        <Border Grid.Row="0" Padding="32,28,32,20"
                                Visibility="{Binding ShowInstancePanel, Converter={StaticResource BoolToVisibility}}">
                            <!-- Tabulación en orden visual: la tuerca (arriba) antes que Abrir carpeta (abajo, pero declarado antes) -->
                            <DockPanel DataContext="{Binding SelectedInstance}" KeyboardNavigation.TabNavigation="Local">
                                <!-- Acciones (editar va en la tuerca; eliminar, dentro del editor) -->
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button Style="{StaticResource GlassButton}" AutomationProperties.Name="Abrir carpeta de la instancia" TabIndex="2"
                                            Command="{Binding DataContext.OpenInstanceFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{StaticResource IconFolder}" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                                            <TextBlock Text="Abrir carpeta" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- Cabecera: icono con el color del cargador, nombre, datos y la tuerca de editar -->
                                <Grid DockPanel.Dock="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="64" Height="64" CornerRadius="14" Background="{StaticResource TileBackground}" BorderThickness="1.5"
                                            BorderBrush="{Binding Loader, Converter={StaticResource LoaderBrush}}">
                                        <TextBlock Text="{Binding Initials}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold"
                                                   Foreground="{Binding Loader, Converter={StaticResource LoaderBrush}}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="18,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource ViewTitle}" FontSize="22" />
                                        <WrapPanel Margin="0,6,0,0">
                                            <Border Style="{StaticResource Chip}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{StaticResource IconCube}" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,7,0" Foreground="{StaticResource Ink3}" />
                                                    <TextBlock Text="{Binding MinecraftVersion, StringFormat=Minecraft {0}}" FontSize="14" Foreground="{StaticResource Ink2}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Chip}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding Loader, Converter={StaticResource LoaderBrush}}" Margin="0,0,7,0" />
                                                    <TextBlock Text="{Binding LoaderText}" FontSize="14" Foreground="{StaticResource Ink2}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Chip}"
                                                    Visibility="{Binding IsSynced, Converter={StaticResource BoolToVisibility}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,7,0" />
                                                    <TextBlock Text="{Binding SyncText}" FontSize="14" Foreground="{StaticResource Ink2}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Chip}"
                                                    Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Style="{StaticResource StatusDot}" Fill="{StaticResource Accent}" Margin="0,0,7,0" />
                                                    <TextBlock Text="{Binding UpdateText}" FontSize="14" Foreground="{StaticResource Ink2}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Chip}"
                                                    Visibility="{Binding MemoryText, Converter={StaticResource TextToVisibility}}">
                                                <TextBlock Text="{Binding MemoryText}" FontSize="14" Foreground="{StaticResource Ink2}" />
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource IconOnlyButton}" Content="{StaticResource IconSettings}"
                                            FontSize="16" VerticalAlignment="Center" ToolTip="Editar instancia" TabIndex="1"
                                            AutomationProperties.Name="Editar instancia"
                                            Command="{Binding DataContext.EditInstanceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            IsEnabled="{Binding DataContext.IsPlayEnabled, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </Grid>

                                <!-- Cifras: un solo bloque agrupado, separado por líneas finas -->
                                <Border DockPanel.Dock="Top" Style="{StaticResource GroupedList}" Margin="0,24,0,0">
                                    <UniformGrid Rows="1" Columns="5">
                                        <Border Style="{StaticResource StatCell}" BorderThickness="0">
                                            <StackPanel>
                                                <TextBlock Text="Última partida" Style="{StaticResource StatLabel}" />
                                                <TextBlock Text="{Binding LastPlayedText}" FontSize="15" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource StatCell}">
                                            <StackPanel>
                                                <TextBlock Text="Mods" Style="{StaticResource StatLabel}" />
                                                <TextBlock Text="{Binding ModCount}" Style="{StaticResource StatValue}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource StatCell}">
                                            <StackPanel>
                                                <TextBlock Text="Mundos" Style="{StaticResource StatLabel}" />
                                                <TextBlock Text="{Binding WorldCount}" Style="{StaticResource StatValue}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource StatCell}">
                                            <StackPanel>
                                                <TextBlock Text="Paquetes de recursos" Style="{StaticResource StatLabel}" />
                                                <TextBlock Text="{Binding ResourcePackCount}" Style="{StaticResource StatValue}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource StatCell}">
                                            <StackPanel>
                                                <TextBlock Text="Shaders" Style="{StaticResource StatLabel}" />
                                                <TextBlock Text="{Binding ShaderPackCount}" Style="{StaticResource StatValue}" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </Border>

                                <!-- Carpeta -->
                                <DockPanel DockPanel.Dock="Top" Margin="2,14,0,0">
                                    <TextBlock Text="{StaticResource IconFolder}" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource Ink3}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Directory}" Style="{StaticResource Hint}" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </DockPanel>

                                <!-- Mods de la instancia (ocupa el espacio que queda) -->
                                <DockPanel Margin="0,24,0,0">
                                    <TextBlock DockPanel.Dock="Top" Text="Mods" Style="{StaticResource GroupLabel}" Margin="2,0,0,10" />
                                    <Border Style="{StaticResource GroupedList}">
                                        <Grid>
                                            <ScrollViewer Template="{StaticResource GlassScrollViewer}" VerticalScrollBarVisibility="Auto" Focusable="False">
                                                <ItemsControl ItemsSource="{Binding ModFiles}" Focusable="False">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource GroupedItemRow}" MinHeight="44">
                                                                <DockPanel>
                                                                    <TextBlock DockPanel.Dock="Left" Text="{StaticResource IconCube}" Style="{StaticResource Icon}" FontSize="13"
                                                                               Width="16" Margin="0,0,12,0"
                                                                               Foreground="{Binding DataContext.Loader, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource LoaderBrush}}" />
                                                                    <TextBlock Text="{Binding}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                </DockPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                            <TextBlock FontSize="13.5" Margin="16" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                       TextAlignment="Center" MaxWidth="440"
                                                       Visibility="{Binding ModFiles.Count, Converter={StaticResource ZeroToVisible}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                                        <Setter Property="Text" Value="Todavía no hay mods. Copia los archivos .jar a la carpeta mods (botón Abrir carpeta)." />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsModded}" Value="False">
                                                                <Setter Property="Text" Value="Las instancias vanilla no cargan mods. Edita la instancia y elige Fabric, Forge, NeoForge o Quilt para usarlos." />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DockPanel>
                            </DockPanel>
                        </Border>

                        <!-- Sin instancias: una tarjeta con el primer paso -->
                        <Border Grid.Row="0" Padding="40"
                                Visibility="{Binding ShowEmptyPanel, Converter={StaticResource BoolToVisibility}}">
                            <Border Style="{StaticResource Card}" Width="460" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource IconTile}" BorderBrush="{StaticResource LoaderVanilla}">
                                            <TextBlock Text="{StaticResource IconAdd}" Style="{StaticResource Icon}" FontSize="14"
                                                       HorizontalAlignment="Center" Foreground="{StaticResource LoaderVanilla}" />
                                        </Border>
                                        <TextBlock Text="Crea tu primera instancia" FontFamily="{StaticResource DisplayFont}" FontSize="20"
                                                   Margin="14,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource CardText}" Margin="0,14,0,0"
                                               Text="Elige la versión de Minecraft y, si quieres mods, Fabric, Forge, NeoForge o Quilt. El launcher descarga e instala todo lo necesario." />
                                    <Border Style="{StaticResource CardFooter}">
                                        <Button Style="{StaticResource PillButton}" HorizontalAlignment="Right" Command="{Binding NewInstanceCommand}"
                                                AutomationProperties.Name="Crear la primera instancia">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{StaticResource IconAdd}" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                                <TextBlock Text="Nueva instancia" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Border>

                        <!-- Explorar contenido: ocupa también el sitio de la barra de juego -->
                        <Border Grid.Row="0" Grid.RowSpan="2" Padding="32,8,24,20"
                                Visibility="{Binding IsBrowsing, Converter={StaticResource BoolToVisibility}}">
                            <views:BrowseView x:Name="BrowsePage" DataContext="{Binding Browse}" />
                        </Border>

                        <!-- Barra de juego: estado, progreso y JUGAR, separada por una línea fina (solo con una instancia a la vista) -->
                        <Border Grid.Row="1" Padding="32,16,24,16" BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0"
                                Visibility="{Binding ShowInstancePanel, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding ActionText}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActionText}" Value="">
                                                        <Setter Property="Text" Value="{Binding SelectedInstance.ReadyText}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding SelectedInstance.Summary}" FontSize="13" Foreground="{StaticResource Ink3}" Margin="0,3,0,0"
                                               Visibility="{Binding IsProgressVisible, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <ProgressBar Style="{StaticResource GlassProgressBar}" Value="{Binding ProgressValue}" Margin="0,10,0,0"
                                                 Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <Button Grid.Column="1" Height="48" Style="{StaticResource GlassPlayButton}"
                                        Content="{Binding PlayButtonText}" IsEnabled="{Binding IsPlayEnabled}"
                                        Command="{Binding PlayCommand}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </c:GlassPanel>
        </Grid>

        <!-- ── Capas modales: su cristal desenfoca la ventana entera ───────────────────── -->
        <Grid c:GlassPanel.Backdrop="{Binding ElementName=MainContent}">
            <views:InstanceEditorOverlay DataContext="{Binding Editor}"
                                         Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}" />
            <views:OptionsOverlay DataContext="{Binding Options}"
                                  Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}" />
            <views:AccountOverlay DataContext="{Binding Account}"
                                  Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}" />
            <views:InstallDialogOverlay DataContext="{Binding Browse.InstallDialog}"
                                        Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}" />
            <views:ConfirmOverlay DataContext="{Binding Confirm}"
                                  Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}" />
            <views:UsernamePromptOverlay DataContext="{Binding UsernamePrompt}"
                                         Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </Grid>
</Window>
