<Window x:Class="KonnorLauncher.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:KonnorLauncher.App.ViewModels"
        xmlns:views="clr-namespace:KonnorLauncher.App.Views"
        xmlns:conv="clr-namespace:KonnorLauncher.App.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Konnor Launcher"
        Icon="pack://application:,,,/Assets/icon.ico"
        Width="1275" Height="700"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Black"
        UseLayoutRounding="True"
        FontFamily="{DynamicResource MainFont}"
        TextOptions.TextFormattingMode="Ideal"
        MouseLeftButtonDown="OnWindowMouseLeftButtonDown"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <conv:InverseBoolConverter x:Key="InverseBool" />
    </Window.Resources>

    <!-- Capa 1: lienzo 1275×700 con posiciones absolutas.
         Capa 2: overlay OPCIONES. Capa 3: overlay ESCRIBE TU NOMBRE. -->
    <Grid>
        <Canvas x:Name="MainCanvas" Width="1275" Height="700" ClipToBounds="True">

            <!-- FONDO: background.png cubriendo toda la ventana; si falla, queda el gradiente -->
            <Border Width="1275" Height="700" Background="{StaticResource FallbackBackground}" />
            <Image Width="1275" Height="700" Stretch="UniformToFill"
                   Source="pack://application:,,,/Assets/background.png"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <!-- CONTROLES DE VENTANA (arriba a la derecha) -->
            <Button Canvas.Left="1235" Canvas.Top="10" Content="✕" Style="{StaticResource WindowControlButton}"
                    Click="OnCloseClick" ToolTipService.IsEnabled="False" />
            <Button Canvas.Left="1199" Canvas.Top="10" Content="—" Style="{StaticResource WindowControlButton}"
                    Click="OnMinimizeClick" />

            <!-- BOTÓN OPCIONES (arriba a la izquierda) -->
            <Button Canvas.Left="12" Canvas.Top="10" Width="126" Height="37" Content="⚙  Opciones"
                    Style="{StaticResource GhostButton}" Command="{Binding OpenOptionsCommand}" />

            <!-- TÍTULO y SUBTÍTULO (no reciben clics: se puede arrastrar la ventana sobre ellos) -->
            <TextBlock Canvas.Left="0" Canvas.Top="28" Width="1275" Height="52" Text="KONNOR"
                       FontSize="{StaticResource Pt38}" FontWeight="Bold" Foreground="{StaticResource White}"
                       TextAlignment="Center" LineStackingStrategy="BlockLineHeight" LineHeight="52"
                       IsHitTestVisible="False" />
            <TextBlock Canvas.Left="0" Canvas.Top="78" Width="1275" Height="24" Text="LAUNCHER"
                       FontSize="{StaticResource Pt13}" Foreground="{StaticResource WhiteA150}"
                       TextAlignment="Center" LineStackingStrategy="BlockLineHeight" LineHeight="24"
                       IsHitTestVisible="False" />

            <!-- MENSAJE DE BIENVENIDA (oculto si no hay nombre y mientras se juega) -->
            <TextBlock Canvas.Left="0" Canvas.Top="572" Width="1275" Height="22" Text="{Binding WelcomeText}"
                       FontSize="{StaticResource Pt12}" FontStyle="Italic" Foreground="{StaticResource WhiteA190}"
                       TextAlignment="Center" IsHitTestVisible="False"
                       Visibility="{Binding IsWelcomeVisible, Converter={StaticResource BoolToVisibility}}" />

            <!-- ESTADO (acción) y BARRA DE PROGRESO sobre el botón JUGAR -->
            <TextBlock Canvas.Left="427" Canvas.Top="570" Width="420" Height="18" Text="{Binding ActionText}"
                       FontSize="{StaticResource Pt10}" FontWeight="Bold" Foreground="{StaticResource White}"
                       TextAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
            <ProgressBar Canvas.Left="427" Canvas.Top="594" Width="420" Height="6" Style="{StaticResource ThinProgressBar}"
                         Value="{Binding ProgressValue}" IsHitTestVisible="False"
                         Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVisibility}}" />

            <!-- BOTÓN JUGAR (centrado abajo) -->
            <Button Canvas.Left="507" Canvas.Top="608" Width="260" Height="56" Style="{StaticResource PlayButton}"
                    Content="{Binding PlayButtonText}" IsEnabled="{Binding IsPlayEnabled}"
                    Command="{Binding PlayCommand}" />

            <!-- SELECTOR DE VERSIÓN (abajo a la izquierda); el popup se abre ENCIMA, 4 px de separación -->
            <ToggleButton x:Name="VersionButton" Canvas.Left="30" Canvas.Top="627" Width="170" Height="44"
                          Style="{StaticResource VersionButton}"
                          IsChecked="{Binding IsVersionPopupOpen, Mode=TwoWay}"
                          IsHitTestVisible="{Binding IsOpen, ElementName=VersionPopup, Converter={StaticResource InverseBool}}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="VERSIÓN ▾" FontSize="{StaticResource Pt9}" FontWeight="Bold" Foreground="{StaticResource White}" />
                    <TextBlock Text="{Binding SelectedVersionLabel}" FontSize="{StaticResource Pt7}" FontWeight="Bold"
                               Foreground="{StaticResource WhiteA140}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </ToggleButton>

            <!-- VERSIÓN DEL LAUNCHER (abajo a la derecha, del ensamblado) -->
            <TextBlock Canvas.Left="1145" Canvas.Top="670" Width="100" Height="18" Text="{Binding LauncherVersionText}"
                       FontSize="{StaticResource Pt9}" FontWeight="Bold" Foreground="{StaticResource White}"
                       TextAlignment="Right" />
        </Canvas>

        <!-- Popup con la lista de versiones (ancho 200, alto min(n,6)×30+12) -->
        <Popup x:Name="VersionPopup" PlacementTarget="{Binding ElementName=VersionButton}" Placement="Top"
               VerticalOffset="-4" AllowsTransparency="True" StaysOpen="False" PopupAnimation="None"
               IsOpen="{Binding IsVersionPopupOpen, Mode=TwoWay}">
            <Border Width="200" Height="{Binding VersionPopupHeight}" Background="{StaticResource PopupBg}"
                    BorderBrush="{StaticResource WhiteA30}" BorderThickness="1" CornerRadius="8" Padding="4">
                <ScrollViewer Template="{StaticResource ThinScrollViewer}" Tag="{StaticResource VersionListScrollBar}"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding VersionItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:VersionItem}">
                                <Button x:Name="Item" Style="{StaticResource VersionListItem}" IsEnabled="{Binding IsSelectable}"
                                        Command="{Binding DataContext.SelectVersionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock x:Name="Label" Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                                </Button>
                                <DataTemplate.Triggers>
                                    <!-- Seleccionada: "✓  ", negrita, #7AE08A y fondo blanco α25 -->
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Item" Property="Background" Value="{StaticResource WhiteA25}" />
                                        <Setter TargetName="Label" Property="FontWeight" Value="Bold" />
                                        <Setter TargetName="Label" Property="Foreground" Value="{StaticResource SelectedVersionText}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Popup>

        <!-- Capa 2: OPCIONES -->
        <views:OptionsOverlay DataContext="{Binding Options}"
                              Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}" />

        <!-- Capa 3: ESCRIBE TU NOMBRE -->
        <views:UsernamePromptOverlay DataContext="{Binding UsernamePrompt}"
                                     Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</Window>
