<UserControl x:Class="KonnorLauncher.App.Views.ContentFilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KonnorLauncher.App.ViewModels"
             xmlns:conv="clr-namespace:KonnorLauncher.App.Converters"
             x:Name="Root">
    <!-- Contenido de una carpeta (mods, shaders, paquetes…) en lista o como iconos, con interruptor y, si se puede, «Quitar».
         La vista y el tamaño son los de la ventana (MainViewModel: ModsGridView, ModsSize…), iguales en instancias y Hosting. -->
    <UserControl.Resources>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:ZeroToVisibleConverter x:Key="ZeroToVisible" />
    </UserControl.Resources>

    <Border Style="{StaticResource GroupedList}">
        <Grid>
            <!-- Lista -->
            <ScrollViewer Template="{StaticResource GlassScrollViewer}" VerticalScrollBarVisibility="Auto" Focusable="False"
                          Visibility="{Binding DataContext.ModsListView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Files, ElementName=Root}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ModFileItem}">
                            <Border Style="{StaticResource GroupedItemRow}"
                                    MinHeight="{Binding DataContext.ModRowHeight, RelativeSource={RelativeSource AncestorType=Window}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconOnlyButton}" Width="30" Height="30" FontSize="12"
                                            Content="{StaticResource IconDelete}" Margin="10,0,0,0" VerticalAlignment="Center"
                                            Command="{Binding RemoveCommand}" ToolTip="Quitar"
                                            Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}"
                                            AutomationProperties.Name="{Binding Name, StringFormat=Quitar {0}}" />
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource SwitchCheckBox}" VerticalAlignment="Center"
                                              IsChecked="{Binding IsEnabled}" IsEnabled="{Binding CanToggle}"
                                              AutomationProperties.Name="{Binding Name, StringFormat=Activar {0}}" />
                                    <Grid DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Center"
                                          Width="{Binding DataContext.ModRowIcon, RelativeSource={RelativeSource AncestorType=Window}}"
                                          Height="{Binding DataContext.ModRowIcon, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <TextBlock Text="{StaticResource IconCube}" Style="{StaticResource Icon}" FontSize="13"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVisibility}}"
                                                   Foreground="{Binding IconBrush, ElementName=Root, TargetNullValue={StaticResource Ink3}}" />
                                        <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                    <TextBlock x:Name="ModName" Text="{Binding Name}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <!-- Desactivado: el nombre apagado -->
                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                    <Setter TargetName="ModName" Property="Foreground" Value="{StaticResource Ink3}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Iconos: icono grande, nombre e interruptor, como el Explorador de Windows -->
            <ScrollViewer Template="{StaticResource GlassScrollViewer}" VerticalScrollBarVisibility="Auto" Focusable="False"
                          Visibility="{Binding DataContext.ModsGridView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Files, ElementName=Root}" Focusable="False" Margin="8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ModFileItem}">
                            <Border x:Name="Tile" Margin="4" Padding="8,12,8,10" CornerRadius="{StaticResource RadiusGroup}" Background="Transparent"
                                    Width="{Binding DataContext.ModTileWidth, RelativeSource={RelativeSource AncestorType=Window}}">
                                <StackPanel>
                                    <Grid HorizontalAlignment="Center"
                                          Width="{Binding DataContext.ModTileIcon, RelativeSource={RelativeSource AncestorType=Window}}"
                                          Height="{Binding DataContext.ModTileIcon, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <Border CornerRadius="10" Background="{StaticResource Surface}"
                                                Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVisibility}}">
                                            <TextBlock Text="{StaticResource IconCube}" Style="{StaticResource Icon}" FontSize="20"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{Binding IconBrush, ElementName=Root, TargetNullValue={StaticResource Ink3}}" />
                                        </Border>
                                        <Image x:Name="TileIcon" Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                    <TextBlock x:Name="TileName" Text="{Binding Name}" FontSize="12.5" Margin="0,8,0,8" TextAlignment="Center"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" ToolTip="{Binding Name}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <!-- Margen negativo: compensa el hueco que el interruptor deja a la izquierda para su texto -->
                                        <CheckBox Style="{StaticResource SwitchCheckBox}" Margin="-16,0,0,0" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsEnabled}" IsEnabled="{Binding CanToggle}"
                                                  AutomationProperties.Name="{Binding Name, StringFormat=Activar {0}}" />
                                        <Button Style="{StaticResource IconOnlyButton}" Width="28" Height="28" FontSize="11" Margin="8,0,0,0"
                                                Content="{StaticResource IconDelete}" Command="{Binding RemoveCommand}" ToolTip="Quitar"
                                                Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}"
                                                AutomationProperties.Name="{Binding Name, StringFormat=Quitar {0}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Tile" Property="Background" Value="{StaticResource RowHover}" />
                                </Trigger>
                                <!-- Desactivado: icono y nombre apagados -->
                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                    <Setter TargetName="TileIcon" Property="Opacity" Value="0.4" />
                                    <Setter TargetName="TileName" Property="Foreground" Value="{StaticResource Ink3}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Style="{StaticResource Hint}" FontSize="13.5" Margin="16" VerticalAlignment="Center" HorizontalAlignment="Center"
                       TextAlignment="Center" MaxWidth="440" TextWrapping="Wrap"
                       Text="{Binding EmptyText, ElementName=Root}"
                       Visibility="{Binding Files.Count, ElementName=Root, Converter={StaticResource ZeroToVisible}}" />
        </Grid>
    </Border>
</UserControl>
