<UserControl x:Class="KonnorLauncher.App.Views.UsernamePromptOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:KonnorLauncher.App.ViewModels"
             xmlns:c="clr-namespace:KonnorLauncher.App.Controls"
             xmlns:conv="clr-namespace:KonnorLauncher.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:UsernamePromptViewModel}"
             IsVisibleChanged="OnIsVisibleChanged">
    <UserControl.Resources>
        <conv:TextToVisibilityConverter x:Key="TextToVisibility" />
    </UserControl.Resources>

    <!-- Antes de la primera partida: el nombre es obligatorio -->
    <Grid Background="{StaticResource ModalScrim}">
        <c:GlassPanel Width="420" Padding="28,26" VerticalAlignment="Center" Style="{StaticResource DialogGlass}">
            <StackPanel KeyboardNavigation.TabNavigation="Cycle">
                <TextBlock Text="Escribe tu nombre" Style="{StaticResource H2}" FontSize="21" />
                <TextBlock Text="Es el nombre con el que te verán los demás en el servidor." Foreground="{StaticResource Ink2}"
                           FontSize="14" TextWrapping="Wrap" Margin="0,8,0,18" />

                <TextBox x:Name="NameBox" Style="{StaticResource GlassTextBox}" Height="42" FontSize="15" MaxLength="16"
                         Tag="Nombre de jugador" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SaveCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap"
                           Visibility="{Binding Error, Converter={StaticResource TextToVisibility}}" />
                <TextBlock Text="De 4 a 16 caracteres: letras, números y guion bajo." Style="{StaticResource Hint}" Margin="0,8,0,0" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button Style="{StaticResource QuietButton}" Content="Cancelar" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource AccentButton}" Content="Guardar y jugar" Command="{Binding SaveCommand}" Padding="20,0" />
                </StackPanel>
            </StackPanel>
        </c:GlassPanel>
    </Grid>
</UserControl>
