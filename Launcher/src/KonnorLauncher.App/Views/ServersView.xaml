<UserControl x:Class="KonnorLauncher.App.Views.ServersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:KonnorLauncher.App.ViewModels"
             xmlns:conv="clr-namespace:KonnorLauncher.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ServersViewModel}">
    <UserControl.Resources>
        <conv:TextToVisibilityConverter x:Key="TextToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:InverseBoolConverter x:Key="InverseBool" />

        <SolidColorBrush x:Key="RowFill" Color="#0AFFFFFF" />
        <SolidColorBrush x:Key="RowFillHover" Color="#12FFFFFF" />
        <SolidColorBrush x:Key="Offline" Color="#66F3F5F7" />
        <SolidColorBrush x:Key="PremiumFill" Color="#1FF5B041" />
        <SolidColorBrush x:Key="PremiumLine" Color="#59F5B041" />

        <!-- ── Select integrado con el fondo, como «Ordenar por: Relevancia ▾» en Mods ── -->
        <Style x:Key="GlassSelect" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource Ink2}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource RadiusButton}" Padding="2,0,8,0">
                            <DockPanel>
                                <TextBlock x:Name="Chevron" DockPanel.Dock="Right" Text="{StaticResource IconChevronDown}" Style="{StaticResource Icon}"
                                           FontSize="10" Margin="10,0,0,0" Foreground="{StaticResource Ink3}" RenderTransformOrigin="0.5,0.5" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                                <Setter TargetName="Chevron" Property="Foreground" Value="{StaticResource Ink}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                                <Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180" /></Setter.Value></Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Menú de un select -->
        <Style x:Key="MenuPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource MenuGlass}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="6" />
        </Style>

        <!-- Un filtro: «Región: Todas ▾» y su menú (con barra si es largo: versiones, categorías) -->
        <DataTemplate x:Key="FilterSelect" DataType="{x:Type vm:ServerFilter}">
            <Grid Margin="0,0,16,0">
                <ToggleButton x:Name="Toggle" IsHitTestVisible="{Binding IsOpen, ElementName=TogglePopup, Converter={StaticResource InverseBool}}" Style="{StaticResource GlassSelect}" IsChecked="{Binding IsOpen}" AutomationProperties.Name="{Binding Name}">
                    <TextBlock>
                        <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=":" /> <Run Text="{Binding SelectedLabel, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                    </TextBlock>
                </ToggleButton>
                <Popup x:Name="TogglePopup" IsOpen="{Binding IsOpen}" PlacementTarget="{Binding ElementName=Toggle}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" MinWidth="200">
                    <Border Style="{StaticResource MenuPanel}">
                        <ScrollViewer Template="{StaticResource GlassScrollViewer}" MaxHeight="360" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Options}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ServerChoice}">
                                        <Button Style="{StaticResource ListOption}" Command="{Binding ChooseCommand}" AutomationProperties.Name="{Binding Label}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{StaticResource IconCheck}" Style="{StaticResource Icon}" FontSize="11"
                                                           Margin="12,0,0,0" VerticalAlignment="Center"
                                                           Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
        </DataTemplate>

        <!-- Fila de servidor: se aclara con el ratón -->
        <Style x:Key="ServerRow" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource RowFill}" />
            <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusGroup}" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource RowFillHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Copiar dirección: el icono pasa a ✓ un momento -->
        <Style x:Key="CopyButton" TargetType="Button" BasedOn="{StaticResource IconOnlyButton}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Content" Value="&#xE8C8;" />
            <Setter Property="ToolTip" Value="Copiar dirección" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCopied}" Value="True">
                    <Setter Property="Content" Value="{StaticResource IconCheck}" />
                    <Setter Property="Foreground" Value="{StaticResource Ok}" />
                    <Setter Property="ToolTip" Value="Copiada" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Punto de estado: verde conectado, gris si no responde -->
        <Style x:Key="OnlineDot" TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
            <Setter Property="Fill" Value="{StaticResource Offline}" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource Ok}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Ping: punto pequeño del color de la calidad, sin fondo (verde ≤ 80 ms, amarillo ≤ 120 ms, rojo más) -->
        <SolidColorBrush x:Key="PingPoor" Color="#F87171" />
        <Style x:Key="PingDot" TargetType="Ellipse">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Margin" Value="0,1,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{StaticResource PingPoor}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PingQuality}" Value="Good">
                    <Setter Property="Fill" Value="{StaticResource Ok}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PingQuality}" Value="Fair">
                    <Setter Property="Fill" Value="{StaticResource Warn}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="PingTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,0,14,0" ToolTip="Ping desde este equipo"
                        Visibility="{Binding HasPing, Converter={StaticResource BoolToVisibility}}">
                <Ellipse Style="{StaticResource PingDot}" />
                <TextBlock Text="{Binding PingText}" FontSize="12.5" Foreground="{StaticResource Ink3}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <!-- Estrella: guardar en Favoritos (rellena y amarilla si ya está) -->
        <Style x:Key="FavoriteButton" TargetType="Button" BasedOn="{StaticResource IconOnlyButton}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Content" Value="&#xE734;" />
            <Setter Property="ToolTip" Value="Añadir a Favoritos" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                    <Setter Property="Content" Value="&#xE735;" />
                    <Setter Property="Foreground" Value="{StaticResource Warn}" />
                    <Setter Property="ToolTip" Value="Quitar de Favoritos" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Meta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource Ink3}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>

        <!-- Campo de texto con texto de ayuda dentro -->
        <Style x:Key="FieldBox" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="14,0,10,0" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Background" Value="{StaticResource FieldQuiet}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource FieldQuietHover}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                    <Setter Property="Background" Value="{StaticResource Group}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FieldInput" TargetType="TextBox">
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
        <Style x:Key="FieldPlaceholder" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="Foreground" Value="{StaticResource Ink3}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Margin" Value="2,0,0,0" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="0,8,0,0">
        <!-- ─── Pestañas, subrayadas sobre una línea fina (como en Mods) ─── -->
        <Grid DockPanel.Dock="Top" Height="50" Margin="0,-8,0,18">
            <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource Hairline}" />
            <StackPanel Orientation="Horizontal" KeyboardNavigation.TabNavigation="Once">
                <RadioButton Style="{StaticResource TopTabSmall}" Height="50" GroupName="ServerTabs" IsChecked="{Binding IsPremiumTab}"
                             AutomationProperties.Name="Premium" ToolTip="Servidores que piden cuenta de Minecraft premium">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE735;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        <TextBlock Text="Premium" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource TopTabSmall}" Height="50" GroupName="ServerTabs" IsChecked="{Binding IsNoPremiumTab}"
                             AutomationProperties.Name="No premium" ToolTip="Servidores en los que se entra con las cuentas de este launcher">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        <TextBlock Text="No premium" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource TopTabSmall}" Height="50" GroupName="ServerTabs" IsChecked="{Binding IsExploreTab}"
                             AutomationProperties.Name="Explorar" ToolTip="Todos los servidores, premium o no">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        <TextBlock Text="Explorar" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource TopTabSmall}" Height="50" GroupName="ServerTabs" IsChecked="{Binding IsMineTab}"
                             AutomationProperties.Name="Favoritos" ToolTip="Los servidores que guardaste">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE734;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        <TextBlock Text="Favoritos" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Grid>

        <Grid>
            <!-- ═══ Descubrir: directorio de Modrinth ═══ -->
            <DockPanel Visibility="{Binding IsDiscover, Converter={StaticResource BoolToVisibility}}">
                <Border DockPanel.Dock="Top" Style="{StaticResource FieldBox}" Height="44" Padding="16,0,9,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="{StaticResource IconSearch}" Style="{StaticResource Icon}" FontSize="14"
                                   Foreground="{StaticResource Ink3}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Grid>
                            <TextBlock Text="{Binding SearchPlaceholder}" Style="{StaticResource FieldPlaceholder}" FontSize="15"
                                       Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource TextToVisibility}, ConverterParameter=invert}" />
                            <TextBox x:Name="SearchBox" Style="{StaticResource FieldInput}" FontSize="15"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Buscar servidores" />
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Orden y filtros, integrados con el fondo (como en Mods); a la derecha, cuántos hay -->
                <DockPanel DockPanel.Dock="Top" Margin="0,14,0,10">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding TotalText}" FontSize="13" Foreground="{StaticResource Ink3}"
                               VerticalAlignment="Center" Margin="12,0,0,0"
                               Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}" />
                    <WrapPanel>
                        <ContentControl Content="{Binding Sort}" ContentTemplate="{StaticResource FilterSelect}" Focusable="False" />
                        <ContentControl Content="{Binding Region}" ContentTemplate="{StaticResource FilterSelect}" Focusable="False" />
                        <ContentControl Content="{Binding Version}" ContentTemplate="{StaticResource FilterSelect}" Focusable="False" />
                        <ContentControl Content="{Binding Category}" ContentTemplate="{StaticResource FilterSelect}" Focusable="False" />
                        <ContentControl Content="{Binding Language}" ContentTemplate="{StaticResource FilterSelect}" Focusable="False" />
                    </WrapPanel>
                </DockPanel>

                <Grid>
                    <ScrollViewer x:Name="ServerScroll" Template="{StaticResource GlassScrollViewer}" VerticalScrollBarVisibility="Auto"
                                  ScrollChanged="OnServerScrollChanged">
                        <StackPanel Margin="0,0,6,0">
                            <ItemsControl ItemsSource="{Binding Servers}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ServerCard}">
                                        <Border Style="{StaticResource ServerRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Icono (o la inicial mientras carga) -->
                                                <Border Width="56" Height="56" CornerRadius="12" Background="{StaticResource TileBackground}"
                                                        VerticalAlignment="Top" Margin="0,0,14,0">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Name[0]}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Ink3}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVisibility}}" />
                                                        <Rectangle RadiusX="12" RadiusY="12" Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}">
                                                            <Rectangle.Fill>
                                                                <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill" />
                                                            </Rectangle.Fill>
                                                        </Rectangle>
                                                    </Grid>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <Border CornerRadius="{StaticResource RadiusSmall}" Background="{StaticResource PremiumFill}"
                                                                BorderBrush="{StaticResource PremiumLine}" BorderThickness="1" Padding="7,1" Margin="10,0,0,0"
                                                                VerticalAlignment="Center"
                                                                ToolTip="Este servidor solo acepta cuentas de Minecraft premium: con una cuenta sin conexión no se puede entrar.">
                                                            <!-- En la pestaña Premium lo son todos: ahí no se marca -->
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding NeedsPremium}" Value="True" />
                                                                                <Condition Binding="{Binding DataContext.IsPremiumTab, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="Requiere premium" FontSize="11.5" Foreground="{StaticResource Warn}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <!-- Descripción; preparando: el avance; si falló: el error -->
                                                    <Grid Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding Summary}" FontSize="13" Foreground="{StaticResource Ink2}" TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                                            <Setter Property="Visibility" Value="Hidden" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding ProgressText}" FontSize="13" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"
                                                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Error}" FontSize="12.5" Foreground="#FCA5A5" TextWrapping="Wrap" Margin="0,4,0,0"
                                                               Visibility="{Binding Error, Converter={StaticResource TextToVisibility}}" />
                                                    <!-- Jugadores, versión, región, idiomas y dirección -->
                                                    <WrapPanel Margin="0,8,0,0">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                                            <Ellipse Style="{StaticResource OnlineDot}" />
                                                            <TextBlock Text="{Binding PlayersText}" Style="{StaticResource Meta}" Foreground="{StaticResource Ink2}" Margin="0" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource Meta}" />
                                                        <TextBlock Text="{Binding RegionText}" Style="{StaticResource Meta}"
                                                                   Visibility="{Binding RegionText, Converter={StaticResource TextToVisibility}}" />
                                                        <TextBlock Text="{Binding LanguagesText}" Style="{StaticResource Meta}"
                                                                   Visibility="{Binding HasLanguages, Converter={StaticResource BoolToVisibility}}" />
                                                        <TextBlock Text="{Binding Address}" Style="{StaticResource Meta}" Margin="0,0,10,0" />
                                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PingTemplate}" Focusable="False" />
                                                    </WrapPanel>
                                                    <ItemsControl ItemsSource="{Binding Tags}" Margin="0,8,0,0" Focusable="False">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{StaticResource RowFill}" BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                                                                        CornerRadius="{StaticResource RadiusSmall}" Padding="8,1" Margin="0,0,6,0">
                                                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource Ink2}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                                <!-- Jugar, copiar dirección, ver en Modrinth -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0">
                                                    <Button Height="36" MinWidth="112" FontSize="14"
                                                            Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat=Jugar en {0}}"
                                                            ToolTip="Crea la instancia del servidor (con su modpack o su versión), lo añade a la lista de servidores del juego y entra.">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                                                <Setter Property="Content" Value="Jugar" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                                        <Setter Property="Content" Value="Preparando…" />
                                                                        <Setter Property="IsEnabled" Value="False" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                                        <Button Style="{StaticResource CopyButton}"
                                                                Command="{Binding DataContext.CopyAddressCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" AutomationProperties.Name="{Binding Address, StringFormat=Copiar {0}}" />
                                                        <Button Style="{StaticResource FavoriteButton}"
                                                                Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat=Favorito {0}}" />
                                                        <Button Style="{StaticResource IconOnlyButton}" Width="32" Height="32" FontSize="13" Content="&#xE774;"
                                                                Command="{Binding DataContext.OpenOnModrinthCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" ToolTip="Ver en Modrinth" AutomationProperties.Name="Ver en Modrinth" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Más resultados (también se cargan solos al llegar al final) -->
                            <Button Style="{StaticResource GlassButton}" Content="Cargar más" HorizontalAlignment="Center" Margin="0,4,0,10" MinWidth="140"
                                    Command="{Binding LoadMoreCommand}"
                                    Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </ScrollViewer>

                    <TextBlock Text="Cargando…" Foreground="{StaticResource Ink2}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="No hay servidores con esos filtros." Foreground="{StaticResource Ink2}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding Error, Converter={StaticResource TextToVisibility}}">
                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource Ink2}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" />
                        <Button Style="{StaticResource GlassButton}" Content="Reintentar" HorizontalAlignment="Center" Margin="0,12,0,0"
                                Command="{Binding RetryCommand}" />
                    </StackPanel>
                </Grid>
            </DockPanel>

            <!-- ═══ Favoritos ═══ -->
            <DockPanel Visibility="{Binding IsMine, Converter={StaticResource BoolToVisibility}}">
                <!-- Añadir: dirección y nombre (opcional) -->
                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource FieldBox}" Margin="0,0,8,0">
                        <Grid>
                            <TextBlock Text="Dirección (servidor.com o servidor.com:25565)" Style="{StaticResource FieldPlaceholder}"
                                       Visibility="{Binding Text, ElementName=AddressBox, Converter={StaticResource TextToVisibility}, ConverterParameter=invert}" />
                            <TextBox x:Name="AddressBox" Style="{StaticResource FieldInput}" KeyDown="OnAddKeyDown"
                                     Text="{Binding NewAddress, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Dirección del servidor" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource FieldBox}" Margin="0,0,8,0">
                        <Grid>
                            <TextBlock Text="Nombre (opcional)" Style="{StaticResource FieldPlaceholder}"
                                       Visibility="{Binding Text, ElementName=NameBox, Converter={StaticResource TextToVisibility}, ConverterParameter=invert}" />
                            <TextBox x:Name="NameBox" Style="{StaticResource FieldInput}" KeyDown="OnAddKeyDown"
                                     Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nombre del servidor" />
                        </Grid>
                    </Border>
                    <Button Grid.Column="2" Style="{StaticResource GlassButton}" Height="40" MinWidth="110" Command="{Binding AddServerCommand}"
                            AutomationProperties.Name="Añadir servidor">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{StaticResource IconAdd}" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Añadir" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock DockPanel.Dock="Top" Text="{Binding AddError}" Foreground="#FCA5A5" FontSize="12.5" Margin="2,8,0,0"
                           Visibility="{Binding AddError, Converter={StaticResource TextToVisibility}}" />

                <!-- A qué instancia se añaden y actualizar el estado -->
                <DockPanel DockPanel.Dock="Top" Margin="0,12,0,12">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GlassButton}" Height="32" FontSize="13" Command="{Binding RefreshSavedCommand}"
                            AutomationProperties.Name="Actualizar estado">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{StaticResource IconSync}" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Actualizar" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding TargetText}" Style="{StaticResource Hint}" FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>

                <Grid>
                    <ScrollViewer Template="{StaticResource GlassScrollViewer}" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SavedServers}" Margin="0,0,6,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SavedServerCard}">
                                    <Border Style="{StaticResource ServerRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Icono del servidor (el que envía él mismo) -->
                                            <Border Width="48" Height="48" CornerRadius="10" Background="{StaticResource TileBackground}" Margin="0,0,14,0">
                                                <Grid>
                                                    <TextBlock Text="{Binding Name[0]}" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Ink3}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVisibility}}" />
                                                    <Rectangle RadiusX="10" RadiusY="10" Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}"
                                                               RenderOptions.BitmapScalingMode="NearestNeighbor">
                                                        <Rectangle.Fill>
                                                            <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill" />
                                                        </Rectangle.Fill>
                                                    </Rectangle>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Address}" Style="{StaticResource Meta}" Margin="10,1,0,0"
                                                               Visibility="{Binding ShowAddress, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <Ellipse Style="{StaticResource OnlineDot}" />
                                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Meta}" Foreground="{StaticResource Ink2}" />
                                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PingTemplate}" Focusable="False" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Motd}" FontSize="12.5" Foreground="{StaticResource Ink3}" TextTrimming="CharacterEllipsis"
                                                           Margin="0,4,0,0" Visibility="{Binding Motd, Converter={StaticResource TextToVisibility}}" />
                                                <TextBlock Text="{Binding Error}" FontSize="12.5" Foreground="#FCA5A5" TextWrapping="Wrap" Margin="0,4,0,0"
                                                           Visibility="{Binding Error, Converter={StaticResource TextToVisibility}}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                                <Button Style="{StaticResource CopyButton}" Margin="0,0,4,0"
                                                        Command="{Binding DataContext.CopyAddressCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding Address, StringFormat=Copiar {0}}" />
                                                <Button Style="{StaticResource IconOnlyButton}" Width="32" Height="32" FontSize="13" Margin="0,0,10,0"
                                                        Content="{StaticResource IconDelete}"
                                                        Command="{Binding DataContext.RemoveServerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" ToolTip="Quitar de la lista" AutomationProperties.Name="{Binding Name, StringFormat=Quitar {0}}" />
                                                <Button Style="{StaticResource AccentButton}" Height="36" MinWidth="100" FontSize="14" Content="Jugar"
                                                        IsEnabled="{Binding DataContext.HasTarget, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Command="{Binding DataContext.PlaySavedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat=Jugar en {0}}"
                                                        ToolTipService.ShowOnDisabled="True"
                                                        ToolTip="{Binding DataContext.TargetText, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="Añade la dirección de un servidor, o pulsa la estrella de uno de la lista, para tenerlo aquí y ver si está en línea." Foreground="{StaticResource Ink2}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"
                               Visibility="{Binding HasNoSaved, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
