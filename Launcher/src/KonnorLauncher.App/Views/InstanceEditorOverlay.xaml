<UserControl x:Class="KonnorLauncher.App.Views.InstanceEditorOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:KonnorLauncher.App.ViewModels"
             xmlns:c="clr-namespace:KonnorLauncher.App.Controls"
             xmlns:conv="clr-namespace:KonnorLauncher.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:InstanceEditorViewModel}"
             IsVisibleChanged="OnIsVisibleChanged">
    <UserControl.Resources>
        <conv:EnumEqualsConverter x:Key="EnumEquals" />
        <conv:TextToVisibilityConverter x:Key="TextToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </UserControl.Resources>

    <!-- Velo modal: oscurece la ventana y captura los clics -->
    <Grid Background="{StaticResource ModalScrim}">
        <c:GlassPanel Width="660" Height="620" Padding="0" Background="{StaticResource GlassTintStrong}" BlurRadius="40">
            <DockPanel KeyboardNavigation.TabNavigation="Cycle">
                <!-- Cabecera -->
                <DockPanel DockPanel.Dock="Top" Margin="28,22,20,10">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconOnlyButton}" Content="{StaticResource IconClose}"
                            FontSize="11" Command="{Binding CancelCommand}" AutomationProperties.Name="Cerrar" />
                    <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" FontSize="21" VerticalAlignment="Center" />
                </DockPanel>

                <!-- Pie -->
                <DockPanel DockPanel.Dock="Bottom" Margin="28,12,28,22">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding CancelCommand}" Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource QuietButton}">
                                    <Setter Property="Content" Value="Cancelar" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSyncing}" Value="True">
                                            <Setter Property="Content" Value="Cancelar descarga" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Style="{StaticResource AccentButton}" Content="{Binding SaveText}" Command="{Binding SaveCommand}" Padding="22,0" />
                    </StackPanel>
                    <Grid Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" FontSize="13" TextWrapping="Wrap"
                                   Visibility="{Binding IsSyncing, Converter={StaticResource InverseBoolToVisibility}}" />
                        <!-- Descarga del contenido del servidor -->
                        <StackPanel Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding SyncStatus}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <ProgressBar Style="{StaticResource GlassProgressBar}" Margin="0,8,0,0" Value="{Binding SyncProgress}"
                                         IsIndeterminate="False"
                                         Visibility="{Binding IsSyncProgressKnown, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Grid>
                </DockPanel>

                <ScrollViewer Template="{StaticResource GlassScrollViewer}" VerticalScrollBarVisibility="Auto" Margin="28,0,14,0">
                    <StackPanel Margin="0,4,14,8" IsEnabled="{Binding IsNotSyncing}">

                        <!-- 1. Nombre -->
                        <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="NameBox" Style="{StaticResource GlassTextBox}" MaxLength="40" AutomationProperties.Name="Nombre de la instancia" Tag="Por ejemplo: Survival con amigos"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{Binding NameError}" Foreground="{StaticResource Danger}" FontSize="12.5" Margin="0,6,0,0"
                                   Visibility="{Binding NameError, Converter={StaticResource TextToVisibility}}" />

                        <!-- 2. Versión de Minecraft: barra horizontal que despliega la lista -->
                        <TextBlock Text="Versión de Minecraft" Style="{StaticResource FieldLabel}" Margin="0,22,0,8" />
                        <ToggleButton Style="{StaticResource DropdownBar}" IsChecked="{Binding IsVersionListOpen}"
                                      IsEnabled="{Binding IsSelectionUnlocked}"
                                      AutomationProperties.Name="Elegir versión de Minecraft">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconCube}" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0" Foreground="{StaticResource Ink2}" />
                                <TextBlock Text="{Binding MinecraftVersionLabel}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <Border Background="{StaticResource SurfaceSunken}" CornerRadius="12" Margin="0,8,0,0" Padding="8"
                                Visibility="{Binding IsVersionListOpen, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBox x:Name="VersionFilterBox" Style="{StaticResource GlassTextBox}" Padding="36,0,12,0" Height="36"
                                             Tag="Buscar versión…" Text="{Binding VersionFilter, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="{StaticResource IconSearch}" Style="{StaticResource Icon}" FontSize="13"
                                               Foreground="{StaticResource Ink3}" Margin="13,0,0,0" IsHitTestVisible="False" />
                                </Grid>
                                <ScrollViewer Template="{StaticResource GlassScrollViewer}" MaxHeight="210" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="VersionList" ItemsSource="{Binding VersionOptions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:VersionOption}">
                                                <Button Style="{StaticResource ListOption}" IsEnabled="{Binding IsSelectable}"
                                                        Command="{Binding DataContext.SelectVersionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <DockPanel>
                                                        <TextBlock x:Name="Check" DockPanel.Dock="Right" Text="{StaticResource IconCheck}" Style="{StaticResource Icon}"
                                                                   FontSize="12" Foreground="{StaticResource Ok}" Visibility="Collapsed" />
                                                        <TextBlock x:Name="Label" Text="{Binding Label}" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </Button>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                                        <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelectable}" Value="False">
                                                        <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Ink3}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- Con sincronización: lo decide el servidor -->
                        <Border Background="#1F4FD18B" CornerRadius="10" Padding="12,9" Margin="0,8,0,0"
                                Visibility="{Binding SyncWithServer, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <TextBlock Text="{StaticResource IconSync}" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource Ok}" Margin="0,0,10,0" />
                                <TextBlock Text="La versión y el cargador los decide el servidor: se detectan al descargar su contenido."
                                           FontSize="13" Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                            </DockPanel>
                        </Border>

                        <!-- 3. Cargador de mods: botones en una zona horizontal -->
                        <TextBlock Text="Cargador de mods" Style="{StaticResource FieldLabel}" Margin="0,22,0,8" />
                        <UniformGrid Rows="1" Columns="5" IsEnabled="{Binding IsSelectionUnlocked}">
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Loader" Content="Vanilla" Margin="0,0,6,0"
                                         IsChecked="{Binding Loader, Converter={StaticResource EnumEquals}, ConverterParameter=Vanilla}" />
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Loader" Content="Fabric" Margin="0,0,6,0"
                                         IsChecked="{Binding Loader, Converter={StaticResource EnumEquals}, ConverterParameter=Fabric}" />
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Loader" Content="Forge" Margin="0,0,6,0"
                                         IsChecked="{Binding Loader, Converter={StaticResource EnumEquals}, ConverterParameter=Forge}" />
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Loader" Content="NeoForge" Margin="0,0,6,0"
                                         IsChecked="{Binding Loader, Converter={StaticResource EnumEquals}, ConverterParameter=NeoForge}" />
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Loader" Content="Quilt"
                                         IsChecked="{Binding Loader, Converter={StaticResource EnumEquals}, ConverterParameter=Quilt}" />
                        </UniformGrid>

                        <!-- 3.1 Versión del cargador: Estable · Última · Otra (solo con un cargador) -->
                        <StackPanel Visibility="{Binding ShowLoaderVersion, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Versión del cargador" Style="{StaticResource FieldLabel}" Margin="0,18,0,8" />
                            <UniformGrid Rows="1" Columns="3" IsEnabled="{Binding IsLoaderAvailable}">
                                <RadioButton Style="{StaticResource SegmentButton}" GroupName="Channel" Content="Estable" Margin="0,0,6,0"
                                             IsChecked="{Binding Channel, Converter={StaticResource EnumEquals}, ConverterParameter=Stable}" />
                                <RadioButton Style="{StaticResource SegmentButton}" GroupName="Channel" Content="Última" Margin="0,0,6,0"
                                             IsChecked="{Binding Channel, Converter={StaticResource EnumEquals}, ConverterParameter=Latest}" />
                                <RadioButton Style="{StaticResource SegmentButton}" GroupName="Channel" Content="Otra"
                                             IsChecked="{Binding Channel, Converter={StaticResource EnumEquals}, ConverterParameter=Specific}" />
                            </UniformGrid>

                            <!-- "Otra": barra con la lista de versiones disponibles -->
                            <StackPanel Margin="0,8,0,0" Visibility="{Binding IsSpecificChannel, Converter={StaticResource BoolToVisibility}}">
                                <ToggleButton Style="{StaticResource DropdownBar}" IsChecked="{Binding IsLoaderListOpen}"
                                              Content="{Binding LoaderListLabel}" AutomationProperties.Name="Elegir versión del cargador" />
                                <Border Background="{StaticResource SurfaceSunken}" CornerRadius="12" Margin="0,8,0,0" Padding="8"
                                        Visibility="{Binding IsLoaderListOpen, Converter={StaticResource BoolToVisibility}}">
                                    <ScrollViewer Template="{StaticResource GlassScrollViewer}" MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding LoaderOptions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:LoaderOption}">
                                                    <Button Style="{StaticResource ListOption}"
                                                            Command="{Binding DataContext.SelectLoaderVersionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
                                                        <DockPanel>
                                                            <TextBlock x:Name="Check" DockPanel.Dock="Right" Text="{StaticResource IconCheck}" Style="{StaticResource Icon}"
                                                                       FontSize="12" Foreground="{StaticResource Ok}" Visibility="Collapsed" />
                                                            <TextBlock x:Name="Label" Text="{Binding Label}" VerticalAlignment="Center" />
                                                        </DockPanel>
                                                    </Button>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{Binding LoaderStatus}" Style="{StaticResource Hint}" Margin="0,10,0,0" FontSize="13" />
                        </StackPanel>

                        <!-- 4. Memoria de esta instancia -->
                        <Border Background="{StaticResource Surface}" CornerRadius="14" Padding="16" Margin="0,24,0,0">
                            <StackPanel>
                                <CheckBox Style="{StaticResource SwitchCheckBox}" IsChecked="{Binding CustomMemory}"
                                          AutomationProperties.Name="Personalizar memoria">
                                    <StackPanel>
                                        <TextBlock Text="Personalizar memoria" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding DefaultMemoryText}" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </CheckBox>
                                <StackPanel Margin="0,16,0,0" Visibility="{Binding CustomMemory, Converter={StaticResource BoolToVisibility}}">
                                    <DockPanel>
                                        <!-- Casilla con la cantidad: al pulsarla se puede escribir -->
                                        <TextBox x:Name="MemoryBox" DockPanel.Dock="Right" Width="96" Margin="16,0,0,0"
                                                 Style="{StaticResource GlassTextBox}" HorizontalContentAlignment="Center"
                                                 FontWeight="SemiBold" AutomationProperties.Name="Memoria en GB"
                                                 Text="{Binding MemoryText, UpdateSourceTrigger=LostFocus}"
                                                 GotKeyboardFocus="OnMemoryBoxFocused" PreviewMouseLeftButtonDown="OnMemoryBoxMouseDown"
                                                 KeyDown="OnMemoryBoxKeyDown" />
                                        <Slider Style="{StaticResource GlassSlider}" VerticalAlignment="Center"
                                                Minimum="{Binding MemoryMinMb}" Maximum="{Binding MemoryMaxMb}" Value="{Binding MemoryMb}"
                                                TickFrequency="{Binding MemoryStepMb}" IsSnapToTickEnabled="True"
                                                SmallChange="{Binding MemoryStepMb}" LargeChange="1024"
                                                AutomationProperties.Name="Memoria para esta instancia" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding MemoryRangeText}" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                                    <TextBlock Text="Es más del 75 % de la memoria del equipo: Windows y otros programas pueden ir lentos."
                                               Foreground="{StaticResource Warn}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Visibility="{Binding IsMemoryHigh, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 5. Servidor -->
                        <Border Background="{StaticResource Surface}" CornerRadius="14" Padding="16" Margin="0,24,0,4">
                            <StackPanel>
                                <CheckBox Style="{StaticResource SwitchCheckBox}" IsChecked="{Binding SyncWithServer}" AutomationProperties.Name="Sincronizar con el servidor"
                                          IsEnabled="{Binding IsSyncSwitchEnabled}">
                                    <StackPanel>
                                        <TextBlock Text="Sincronizar con el servidor" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                                   Text="Antes de jugar se comprueban y descargan los archivos del servidor de actualización. La instancia guarda su propia copia del juego." />
                                    </StackPanel>
                                </CheckBox>
                                <!-- Vinculada o liberada por el servidor -->
                                <Border Background="#1F4FD18B" CornerRadius="10" Padding="12,9" Margin="0,14,0,0"
                                        Visibility="{Binding SyncLockText, Converter={StaticResource TextToVisibility}}">
                                    <DockPanel>
                                        <TextBlock Text="{StaticResource IconSync}" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource Ok}" Margin="0,0,10,0" VerticalAlignment="Top" />
                                        <TextBlock Text="{Binding SyncLockText}" FontSize="13" Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                                    </DockPanel>
                                </Border>
                                <StackPanel Margin="0,14,0,0" Visibility="{Binding SyncWithServer, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Dirección del servidor" Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource GlassTextBox}" Tag="http://servidor:59381" AutomationProperties.Name="Dirección del servidor"
                                             IsEnabled="{Binding IsUrlEditable}"
                                             Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Style="{StaticResource SwitchCheckBox}" Margin="0,16,0,0" IsChecked="{Binding InstallPacks}"
                                              IsEnabled="{Binding IsPacksSwitchEnabled}" AutomationProperties.Name="Instalar paquetes de recursos">
                                        <StackPanel>
                                            <TextBlock Text="Instalar paquetes de recursos" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" Text="{Binding PacksHint}" />
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 6. Eliminar (solo al editar una instancia existente) -->
                        <Border Background="#12FF6B6B" CornerRadius="14" Padding="16" Margin="0,24,0,4"
                                Visibility="{Binding IsNew, Converter={StaticResource InverseBoolToVisibility}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Margin="16,0,0,0" VerticalAlignment="Center"
                                        Command="{Binding RequestDeleteCommand}" AutomationProperties.Name="Eliminar instancia">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{StaticResource IconDelete}" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                                        <TextBlock Text="Eliminar" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <StackPanel>
                                    <TextBlock Text="Eliminar instancia" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                               Text="Borra su carpeta con los mods, la configuración y los mundos." />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </c:GlassPanel>
    </Grid>
</UserControl>
