<UserControl x:Class="KonnorLauncher.App.Views.AccountOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:KonnorLauncher.App.ViewModels"
             xmlns:c="clr-namespace:KonnorLauncher.App.Controls"
             xmlns:conv="clr-namespace:KonnorLauncher.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AccountViewModel}"
             IsVisibleChanged="OnIsVisibleChanged">
    <UserControl.Resources>
        <conv:TextToVisibilityConverter x:Key="TextToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />

        <!-- Clásico / Delgado: botones de segmento; el elegido, en verde -->
        <Style x:Key="ClassicSegment" TargetType="Button" BasedOn="{StaticResource GlassButton}">
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSlim}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Surface}" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="Foreground" Value="{StaticResource Ink2}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SlimSegment" TargetType="Button" BasedOn="{StaticResource GlassButton}">
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Ink2}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSlim}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentSoft}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                    <Setter Property="Foreground" Value="{StaticResource Ink}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource ModalScrim}">
        <c:GlassPanel Width="780" Height="600" Padding="0" Style="{StaticResource DialogGlass}" BlurRadius="40">
            <DockPanel KeyboardNavigation.TabNavigation="Cycle">
                <!-- Cabecera -->
                <DockPanel DockPanel.Dock="Top" Margin="28,22,20,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconOnlyButton}" Content="{StaticResource IconClose}"
                            FontSize="11" Command="{Binding CancelCommand}" AutomationProperties.Name="Cerrar" />
                    <StackPanel>
                        <TextBlock Text="Cuenta sin conexión" Style="{StaticResource H2}" FontSize="21" />
                        <TextBlock Text="Tu nombre, tu foto de perfil y tu skin." Style="{StaticResource Hint}" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>

                <!-- Pie -->
                <DockPanel DockPanel.Dock="Bottom" Margin="28,12,28,22">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource QuietButton}" Content="Cancelar" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource AccentButton}" Content="Guardar" Command="{Binding SaveCommand}" Padding="24,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center"
                               Visibility="{Binding Error, Converter={StaticResource TextToVisibility}}" />
                </DockPanel>

                <Grid Margin="28,12,28,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- ── Skin: vista 3D ─────────────────────────────────────── -->
                    <StackPanel Grid.Column="0">
                        <Border CornerRadius="{StaticResource RadiusGroup}" BorderBrush="{StaticResource Hairline}" BorderThickness="1" Height="318">
                            <Border.Background>
                                <RadialGradientBrush Center="0.5,0.62" GradientOrigin="0.5,0.62" RadiusX="0.75" RadiusY="0.6">
                                    <GradientStop Color="#333478F6" Offset="0" />
                                    <GradientStop Color="#0DFFFFFF" Offset="0.7" />
                                    <GradientStop Color="#08FFFFFF" Offset="1" />
                                </RadialGradientBrush>
                            </Border.Background>
                            <Grid>
                                <!-- Sombra en el suelo -->
                                <Ellipse Width="120" Height="18" VerticalAlignment="Bottom" Margin="0,0,0,22">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#66000000" Offset="0" />
                                            <GradientStop Color="#00000000" Offset="1" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <c:SkinViewer3D Skin="{Binding Skin}" Slim="{Binding IsSlim}" Margin="0,8,0,16"
                                                AutomationProperties.Name="Vista 3D de la skin" />
                                <TextBlock Text="Mantén pulsado para girar · rueda para acercar" Style="{StaticResource Hint}" FontSize="11.5"
                                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6" IsHitTestVisible="False" />
                            </Grid>
                        </Border>

                        <UniformGrid Columns="2" Margin="0,12,0,0">
                            <Button Style="{StaticResource ClassicSegment}" Content="Clásico" Margin="0,0,4,0"
                                    Command="{Binding SetModelCommand}" CommandParameter="classic" ToolTip="Brazos de 4 píxeles (Steve)" />
                            <Button Style="{StaticResource SlimSegment}" Content="Delgado" Margin="4,0,0,0"
                                    Command="{Binding SetModelCommand}" CommandParameter="slim" ToolTip="Brazos de 3 píxeles (Alex)" />
                        </UniformGrid>
                    </StackPanel>

                    <!-- ── Perfil ─────────────────────────────────────────────── -->
                    <ScrollViewer Grid.Column="2" Template="{StaticResource GlassScrollViewer}" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,10,8">
                            <!-- Foto de perfil -->
                            <TextBlock Text="Foto de perfil" Style="{StaticResource FieldLabel}" />
                            <DockPanel Margin="0,4,0,0">
                                <Grid Width="84" Height="84" DockPanel.Dock="Left">
                                    <Border CornerRadius="42" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                            Visibility="{Binding HasAvatar, Converter={StaticResource InverseBoolToVisibility}}">
                                        <TextBlock Text="{Binding Initials}" FontSize="26" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Ellipse Stroke="#40FFFFFF" StrokeThickness="1"
                                             Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVisibility}}">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>
                                <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource GlassButton}" Content="Cambiar foto" Command="{Binding ChooseAvatarCommand}" />
                                        <Button Style="{StaticResource QuietButton}" Content="Quitar" Margin="8,0,0,0" Command="{Binding RemoveAvatarCommand}"
                                                Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <TextBlock Text="PNG, JPG, BMP o GIF. Se recorta el centro en cuadrado." Style="{StaticResource Hint}" Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding AvatarError}" Foreground="{StaticResource Danger}" FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding AvatarError, Converter={StaticResource TextToVisibility}}" />
                                </StackPanel>
                            </DockPanel>

                            <!-- Nombre -->
                            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                                <TextBlock Text="Nombre de jugador" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="4 a 16 letras, números o _" Style="{StaticResource Hint}" Margin="10,1,0,0" />
                            </StackPanel>
                            <TextBox x:Name="UsernameBox" Style="{StaticResource GlassTextBox}" MaxLength="16" Tag="Nombre de jugador" AutomationProperties.Name="Nombre de jugador"
                                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{Binding UsernameError}" Foreground="{StaticResource Danger}" FontSize="12.5" Margin="0,6,0,0"
                                       Visibility="{Binding UsernameError, Converter={StaticResource TextToVisibility}}" />

                            <!-- Skin -->
                            <TextBlock Text="Skin" Style="{StaticResource FieldLabel}" Margin="0,24,0,8" />
                            <Border Style="{StaticResource GroupedList}" Padding="14,12">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource GlassButton}" Content="Elegir skin" Command="{Binding ChooseSkinCommand}" />
                                        <Button Style="{StaticResource QuietButton}" Content="Usar Steve" Margin="8,0,0,0" Command="{Binding ResetSkinCommand}"
                                                Visibility="{Binding IsCustomSkin, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding SkinName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="PNG de 64×64 o 64×32 píxeles" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <TextBlock Text="{Binding SkinError}" Foreground="{StaticResource Danger}" FontSize="12.5" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding SkinError, Converter={StaticResource TextToVisibility}}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                                       Text="Con una cuenta sin conexión, el juego no descarga skins: dentro del juego tu skin solo la ven quienes usen un mod de skins." />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </c:GlassPanel>
    </Grid>
</UserControl>
