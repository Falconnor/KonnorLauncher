<UserControl x:Class="KonnorLauncher.App.Views.OptionsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:KonnorLauncher.App.ViewModels"
             xmlns:c="clr-namespace:KonnorLauncher.App.Controls"
             xmlns:conv="clr-namespace:KonnorLauncher.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:OptionsViewModel}"
             IsVisibleChanged="OnIsVisibleChanged">
    <UserControl.Resources>
        <conv:TextToVisibilityConverter x:Key="TextToVisibility" />

        <!-- RAM: opciones como botones de segmento -->
        <Style x:Key="RamItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Ink2}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{StaticResource Surface}" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="9" Height="34" MinWidth="62" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}" />
                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource ModalScrim}">
        <c:GlassPanel Width="620" Height="652" Padding="0" Background="{StaticResource GlassTintStrong}" BlurRadius="40">
            <DockPanel KeyboardNavigation.TabNavigation="Cycle">
                <!-- Cabecera -->
                <DockPanel DockPanel.Dock="Top" Margin="28,22,20,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconOnlyButton}" Content="{StaticResource IconClose}"
                            FontSize="11" Command="{Binding CancelCommand}" AutomationProperties.Name="Cerrar" />
                    <StackPanel>
                        <TextBlock Text="Opciones" Style="{StaticResource H2}" FontSize="21" />
                        <TextBlock Text="Ajustes comunes a todas las instancias. El nombre y la skin están en tu cuenta (abajo a la izquierda)." Style="{StaticResource Hint}" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>

                <!-- Pie -->
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="28,12,28,22">
                    <Button Style="{StaticResource QuietButton}" Content="Cancelar" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource AccentButton}" Content="Guardar" Command="{Binding SaveCommand}" Padding="24,0" />
                </StackPanel>

                <ScrollViewer Template="{StaticResource GlassScrollViewer}" VerticalScrollBarVisibility="Auto" Margin="28,8,14,0">
                    <StackPanel Margin="0,0,14,8">
                        <!-- RAM -->
                        <TextBlock Text="Memoria para el juego" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" />
                        <ListBox ItemsSource="{Binding RamOptions}" SelectedItem="{Binding SelectedRam}" DisplayMemberPath="Display"
                                 ItemContainerStyle="{StaticResource RamItem}" Background="Transparent" BorderThickness="0" Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Memoria para el juego">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>

                        <!-- Java -->
                        <TextBlock Text="Java" Style="{StaticResource FieldLabel}" Margin="0,16,0,8" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GlassButton}" Content="Examinar" Margin="8,0,0,0"
                                    Command="{Binding BrowseJavaCommand}" />
                            <TextBox Style="{StaticResource GlassTextBox}" Tag="Automático: el Java correcto para cada versión (recomendado)"
                                     Text="{Binding JavaPath, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>

                        <!-- Carpeta de datos -->
                        <Border Background="{StaticResource Surface}" CornerRadius="14" Padding="16,14" Margin="0,24,0,0">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GlassButton}" Margin="12,0,0,0"
                                        Command="{Binding OpenDataFolderCommand}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{StaticResource IconFolder}" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="Abrir" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <StackPanel>
                                    <TextBlock Text="Carpeta de datos" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DataDir}" Style="{StaticResource Hint}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0"
                                               Text="instances: una carpeta por instancia · meta: versiones, librerías, assets y Java compartidos" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </c:GlassPanel>
    </Grid>
</UserControl>
