<Application x:Class="KonnorLauncher.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:KonnorLauncher.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <!-- Sin StartupUri: la ventana principal se crea desde el host (DI) en App.xaml.cs -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Paleta antigua (de ella solo se usa el fondo de respaldo) -->
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <!-- Glassmorphism (mismo diseño que el panel del servidor) -->
                <ResourceDictionary Source="Themes/Glass.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:LoaderBrushConverter x:Key="LoaderBrush" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
